const baseExtraBuild=build;build=function(){const stages=extraStages[cur.name];if(!stages)return baseExtraBuild();const n=Math.max(vals.length,10),out=[];stages.forEach((text,i)=>{const active=[(i*2)%n,((i*2)+1)%n];out.push({active,done:Array.from({length:Math.min(i,n)},(_,k)=>k),text})});out.push({done:Array.from({length:n},(_,k)=>k),text:`${cur.name} concluido.`});return out};extraAlgorithms.forEach(a=>a.dedicated=true);select(cur.id);
</script>
<script is:inline>
const detailedGuide=document.querySelector('.complexity-guide');if(detailedGuide)detailedGuide.innerHTML='<div class="guide-box"><h4>⏱️ Time Complexity — tempo</h4><p>Indica quantas operacoes o algoritmo faz conforme <b>n</b>, o tamanho da entrada, cresce. Nao e o tempo exato em segundos: e uma forma de comparar o crescimento.</p><p style="margin-top:7px"><b>Exemplo com 10, 100 e 1.000 itens:</b></p><div class="complexity-example"><span><b>O(1)</b> acesso por indice</span><span>1 → 1 → 1 operacao</span><span><b>O(log n)</b> busca binaria</span><span>~3 → ~7 → ~10 passos</span><span><b>O(n)</b> ler a lista inteira</span><span>10 → 100 → 1.000 passos</span><span><b>O(n²)</b> comparar todos os pares</span><span>100 → 10.000 → 1.000.000 comparacoes</span></div><p style="margin-top:7px;color:var(--t)">Por isso, um algoritmo O(n²) que parece aceitavel com 10 itens pode ficar muito lento com 1.000.</p><div class="complexity-scale"><span class="c-fast">O(1) constante</span><span class="c-good">O(log n) cresce devagar</span><span class="c-warn">O(n) proporcional</span><span class="c-slow">O(n²) cresce rapido</span></div></div><div class="guide-box"><h4>💾 Space Complexity — memoria</h4><p>Indica a <b>memoria extra</b> usada pelo algoritmo alem dos dados que ja recebemos. Tambem analisamos como essa memoria cresce com <b>n</b>.</p><p style="margin-top:7px"><b>Exemplo com 10, 100 e 1.000 itens:</b></p><div class="complexity-example"><span><b>O(1)</b> duas variaveis e alguns indices</span><span>2 → 2 → 2 espacos</span><span><b>O(n)</b> copia, fila, pilha ou tabela</span><span>10 → 100 → 1.000 espacos</span></div><p style="margin-top:7px;color:var(--t)">Bubble Sort pode trocar itens no proprio array e usar O(1). Merge Sort cria partes auxiliares e costuma usar O(n). Em recursao, cada chamada tambem ocupa memoria na pilha.</p><div class="complexity-scale"><span class="c-fast">O(1) memoria fixa</span><span class="c-warn">O(n) memoria cresce</span></div></div>';
</script>
<script is:inline>
(()=>{const guide=document.querySelector('.complexity-guide');if(!guide)return;const box=document.createElement('div');box.className='scale-box';box.innerHTML='<h4>📈 Teste de escala: e se n chegar a 10 milhões?</h4><p>Escolha o tamanho da entrada. A tabela estima o crescimento sem criar esses dados de verdade, então o navegador continua leve.</p><label for="scale-size">Tamanho da entrada (n)</label><select id="scale-size"><option value="10">10 itens</option><option value="100">100 itens</option><option value="1000">1.000 itens</option><option value="10000">10.000 itens</option><option value="100000">100.000 itens</option><option value="1000000">1 milhão de itens</option><option value="10000000">10 milhões de itens</option></select><div class="scale-results" aria-live="polite"></div><p class="scale-note">As operações são uma aproximação didática. O hardware, a implementação e o melhor/pior caso podem mudar o tempo real.</p>';guide.appendChild(box);const select=box.querySelector('#scale-size'),results=box.querySelector('.scale-results');const fmt=n=>n>=1e12?(n/1e12).toFixed(n%1e12?1:0)+' trilhões':n>=1e9?(n/1e9).toFixed(n%1e9?1:0)+' bilhões':n>=1e6?(n/1e6).toFixed(n%1e6?1:0)+' milhões':n>=1e3?(n/1e3).toFixed(n%1e3?1:0)+' mil':Math.round(n).toLocaleString('pt-BR');const update=()=>{const n=Number(select.value),log=Math.max(1,Math.ceil(Math.log2(n))),square=n*n;results.innerHTML='<div><b>O(1)</b><span>~1 operação</span><em>não cresce</em></div><div><b>O(log n)</b><span>~'+fmt(log)+' passos</span><em>busca binária</em></div><div><b>O(n)</b><span>~'+fmt(n)+' operações</span><em>uma leitura</em></div><div><b>O(n²)</b><span>~'+fmt(square)+' comparações</span><em>pode ficar inviável</em></div><div><b>Memória O(1)</b><span>algumas variáveis</span><em>fixa</em></div><div><b>Memória O(n)</b><span>~'+fmt(n)+' posições extras</span><em>cresce com n</em></div>'};select.addEventListener('change',update);update()})();
</script>
<style is:global>.scale-box{grid-column:1/-1;margin-top:2px;padding:13px;border:1px solid #7c5cff66;border-radius:12px;background:linear-gradient(135deg,#17132b,#101722)}.scale-box h4{margin:0 0 5px;font-size:.84rem;color:var(--t)}.scale-box p{margin:0 0 8px}.scale-box label{display:block;color:var(--m);font-size:.74rem;margin-bottom:4px}.scale-box select{width:100%;padding:8px;border:1px solid var(--l);border-radius:8px;background:var(--p2);color:var(--t)}.scale-results{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:9px}.scale-results div{display:grid;gap:2px;padding:8px;border:1px solid var(--l);border-radius:8px;background:#0b111b}.scale-results b{color:#9af5eb;font-size:.74rem}.scale-results span{color:var(--t);font-size:.76rem}.scale-results em{color:var(--m);font-size:.65rem;font-style:normal}.scale-note{margin-top:8px!important;font-size:.68rem!important;color:var(--m)!important}@media(max-width:700px){.scale-results{grid-template-columns:repeat(2,1fr)}}@media(max-width:420px){.scale-results{grid-template-columns:1fr}}</style>
<script is:inline>
(()=>{const guide=document.querySelector('.complexity-guide');if(!guide)return;const box=document.createElement('div');box.className='library-box';box.innerHTML='<h4>📚 Cenário realista: biblioteca com 50 mil livros</h4><p>Simule uma coleção com gênero, preço, ano, páginas, vendas e reedições. Os 50 mil registros são representados estatisticamente; a tela mostra alguns livros de exemplo para não travar o navegador.</p><div class="library-controls"><label>Classificar por<select id="library-field"><option value="genre">Gênero</option><option value="price">Preço</option><option value="year">Ano</option><option value="pages">Número de páginas</option><option value="sales">Vendas</option><option value="editions">Reedições</option></select></label><label>Algoritmo<select id="library-algo"><option value="tim">Tim Sort</option><option value="merge">Merge Sort</option><option value="quick">Quick Sort</option><option value="heap">Heap Sort</option><option value="counting">Counting Sort</option><option value="radix">Radix Sort</option><option value="bubble">Bubble Sort</option></select></label><button id="library-run" class="btn primary">▶ Classificar 50 mil livros</button></div><div class="library-result" aria-live="polite"></div><p class="library-note">Esta é uma demonstração com dados sintéticos. Em um sistema real, os livros viriam de banco de dados e o algoritmo poderia ser aplicado no servidor ou em um índice.</p>';guide.appendChild(box);const fields=box.querySelector('#library-field'),algo=box.querySelector('#library-algo'),result=box.querySelector('.library-result');const titles=['Dom Casmurro','O Cortiço','A Hora da Estrela','Grande Sertão: Veredas','Memórias Póstumas de Brás Cubas','Capitães da Areia','Vidas Secas','O Alienista'];const genres=['Romance','Ficção','História','Fantasia','Biografia','Ciência','Poesia','Tecnologia'];const seed=i=>(i*9301+49297)%233280;const book=i=>({title:titles[i%titles.length],genre:genres[i%genres.length],price:18+(seed(i)%480)/10,year:1950+(seed(i+3)%75),pages:80+(seed(i+7)%820),sales:100+(seed(i+11)%990000),editions:1+(seed(i+13)%24)});const labels={genre:'gênero',price:'preço',year:'ano',pages:'número de páginas',sales:'vendas',editions:'reedições'};const fmt=n=>n>=1e6?(n/1e6).toFixed(1)+' milhões':n>=1e3?(n/1e3).toFixed(1)+' mil':Math.round(n).toLocaleString('pt-BR');const run=()=>{const field=fields.value,name=algo.value,n=50000,log=Math.ceil(Math.log2(n)),range=field==='year'?75:field==='pages'?900:field==='editions'?24:field==='price'?480:field==='sales'?990000:8;let ops,reason;if(name==='bubble'){ops=n*(n-1)/2;reason='Didático, mas inviável para 50 mil livros.'}else if(name==='counting'){ops=n+range;reason='Excelente quando o campo é inteiro e tem intervalo pequeno.'}else if(name==='radix'){ops=n*6;reason='Bom para vendas, anos ou códigos numéricos.'}else{ops=n*log;reason=name==='tim'?'Ótimo para dados parcialmente ordenados.':'Boa escolha geral para ordenar registros.'}const sample=Array.from({length:8},(_,i)=>book(i+17)).sort((a,b)=>field==='genre'?a.genre.localeCompare(b.genre):a[field]-b[field]);const value=b=>field==='price'?'R$ '+b.price.toFixed(2):field==='sales'?fmt(b.sales):b[field];result.innerHTML='<div class="library-summary"><b>50.000 livros</b><span>Ordenação por '+labels[field]+'</span><span>Estimativa: ~'+fmt(ops)+' operações</span><em>'+reason+'</em></div><div class="library-books">'+sample.map((b,i)=>'<div><strong>'+(i+1)+'. '+b.title+'</strong><span>'+b.genre+' · '+b.year+' · '+b.pages+' páginas</span><b>'+value(b)+'</b></div>').join('')+'</div>'};box.querySelector('#library-run').addEventListener('click',run);run()})();
</script>
