ia',merge:'Merge Sort + busca',quick:'Quick Sort + busca',bubble:'Bubble Sort + busca',tim:'Tim Sort + busca',heap:'Heap Sort + busca'};const q=sim.querySelector('#v2-request'),sa=sim.querySelector('#v2-a'),sb=sim.querySelector('#v2-b'),status=sim.querySelector('#v2-status');let timers=[],winner=null,run=0;const sorted=()=>titles.map((_,i)=>i).sort((x,y)=>titles[x].localeCompare(titles[y]));const make=(method,target)=>({method,target,order:method==='binary'?sorted():titles.map((_,i)=>i),phase:method==='binary'||method==='linear'?'search':'sort',cursor:0,lo:0,hi:9,active:-1,found:-1,loaned:-1,steps:0,message:'Aguardando...'});const draw=(state,books,step)=>{books.innerHTML=state.order.map((idx,pos)=>'<span class="loan-card '+(state.active===idx?'checking ':'')+(state.found===idx?'found ':'')+(state.loaned===idx?'loaned ':'')+'">'+(pos+1)+'. '+titles[idx]+'</span>').join('');step.textContent=state.message};const next=state=>{state.steps++;if(state.phase==='sort'){if(state.cursor>=10){state.phase='search';state.cursor=0;state.active=-1;return 'Estante organizada; iniciando a busca.'}let min=state.cursor;for(let j=state.cursor+1;j<10;j++)if(titles[state.order[j]]<titles[state.order[min]])min=j;[state.order[state.cursor],state.order[min]]=[state.order[min],state.order[state.cursor]];state.active=state.order[state.cursor];state.cursor++;return labels[state.method].split(' +')[0]+': comparando e trocando posições.'}if(state.method==='binary'){if(state.lo>state.hi)return 'Intervalo encerrado.';const mid=Math.floor((state.lo+state.hi)/2),idx=state.order[mid];state.active=idx;if(idx===state.target){state.found=idx;return 'Busca binária encontrou o livro.'}if(titles[idx].localeCompare(titles[state.target])<0)state.lo=mid+1;else state.hi=mid-1;return 'Busca binária: descartando metade da estante.'}if(state.cursor>=10)return 'Livro não encontrado.';const idx=state.order[state.cursor++];state.active=idx;if(idx===state.target){state.found=idx;return 'Livro encontrado após conferir '+state.steps+' posição(ões).'}return labels[state.method]+': conferindo o livro '+state.steps+'.'};const lane=(state,books,step,who,id)=>{if(id!==run)return;if(state.found>=0){if(winner===null){winner=who;state.loaned=state.found;status.textContent=who+' encontrou primeiro e reservou a única cópia.'}else if(winner!==who){state.loaned=state.found;status.textContent='Conflito: '+winner+' ganhou a cópia; '+who+' encontrou, mas o livro já está emprestado.'}draw(state,books,step);return}state.message=next(state);draw(state,books,step);timers.push(setTimeout(()=>lane(state,books,step,who,id),360))};const updateLabels=()=>{sim.querySelector('#v2-label-a').textContent='· '+labels[sa.value];sim.querySelector('#v2-label-b').textContent='· '+labels[sb.value]};const start=()=>{timers.forEach(clearTimeout);timers=[];winner=null;run++;const target=Number(q.value),id=run,aa=make(sa.value,target),bb=make(sb.value,target);updateLabels();status.textContent='Os dois clientes pediram “'+titles[target]+'”. Existe apenas uma cópia.';lane(aa,sim.querySelector('#v2-books-a'),sim.querySelector('#v2-step-a'),'Atendente A',id);lane(bb,sim.querySelector('#v2-books-b'),sim.querySelector('#v2-step-b'),'Atendente B',id)};sa.addEventListener('change',updateLabels);sb.addEventListener('change',updateLabels);sim.querySelector('#v2-run').addEventListener('click',start);updateLabels();start()})();
