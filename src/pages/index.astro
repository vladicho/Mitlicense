<section class="compare-card" aria-label="Comparar algoritmos"><div class="compare-head"><h3>Comparar dois algoritmos</h3><span class="muted">mesma entrada, duas execuções</span></div><div class="compare-controls"><select id="compare-a" aria-label="Primeiro algoritmo"></select><select id="compare-b" aria-label="Segundo algoritmo"></select><button id="compare-run" class="btn primary">Executar comparação</button><button id="compare-reset" class="btn">Limpar</button></div><div class="compare-grid"><div class="compare-pane"><h4 id="compare-title-a">Bubble Sort</h4><div id="compare-status-a" class="compare-status">Aguardando...</div><div id="compare-visual-a" class="compare-visual"></div></div><div class="compare-pane"><h4 id="compare-title-b">Quick Sort</h4><div id="compare-status-b" class="compare-status">Aguardando...</div><div id="compare-visual-b" class="compare-visual"></div></div></div><p class="compare-note">Os dois lados recebem exatamente a mesma lista. O numero de etapas ajuda a comparar o comportamento didatico da animacao; nao substitui um benchmark real.</p></section>
<script is:inline>
const compareA=document.getElementById('compare-a'),compareB=document.getElementById('compare-b'),compareRun=document.getElementById('compare-run'),compareReset=document.getElementById('compare-reset');let compareTimer,compareState;
algorithms.forEach(a=>{const label=a.name;compareA.add(new Option(label,a.id));compareB.add(new Option(label,a.id))});compareA.value='a0';compareB.value='a4';
function compareSteps(algo,inputValues){const savedCur=cur,savedVals=[...vals];cur=algo;vals=[...inputValues];const actions=build();cur=savedCur;vals=savedVals;return actions}
function compareDraw(id,values,action){const root=document.getElementById(id);root.innerHTML='';const max=Math.max(...values.map(v=>Number(v)||0),1);values.forEach((v,i)=>{const bar=document.createElement('div');bar.className='compare-bar';bar.style.height=`${Math.max(8,(Number(v)||0)/max*100)}%`;if((action?.active||[]).includes(i))bar.classList.add('active');if((action?.done||[]).includes(i))bar.classList.add('done');root.appendChild(bar)})}
function compareStart(){clearTimeout(compareTimer);const inputValues=randomArray(12),a=algorithms.find(x=>x.id===compareA.value),b=algorithms.find(x=>x.id===compareB.value);compareState={a,b,sa:compareSteps(a,inputValues),sb:compareSteps(b,inputValues),pa:0,pb:0,values:[...inputValues]};document.getElementById('compare-title-a').textContent=a.name;document.getElementById('compare-title-b').textContent=b.name;compareTick()}
function compareTick(){if(!compareState)return;const s=compareState,aa=s.sa[s.pa],bb=s.sb[s.pb];if(aa){if(aa.values)s.values=[...aa.values];compareDraw('compare-visual-a',s.values,aa);document.getElementById('compare-status-a').textContent=`Etapa ${s.pa+1} de ${s.sa.length}: ${aa.text||'processando'}`;s.pa++}if(bb){if(bb.values)s.values=[...bb.values];compareDraw('compare-visual-b',s.values,bb);document.getElementById('compare-status-b').textContent=`Etapa ${s.pb+1} de ${s.sb.length}: ${bb.text||'processando'}`;s.pb++}if(s.pa<s.sa.length||s.pb<s.sb.length)compareTimer=setTimeout(compareTick,320);else{document.getElementById('compare-status-a').textContent=`Concluido — ${s.sa.length} etapas`;document.getElementById('compare-status-b').textContent=`Concluido — ${s.sb.length} etapas`}}
compareRun.onclick=compareStart;compareReset.onclick=()=>{clearTimeout(compareTimer);compareState=null;document.getElementById('compare-visual-a').innerHTML='';document.getElementById('compare-visual-b').innerHTML='';document.getElementById('compare-status-a').textContent='Aguardando...';document.getElementById('compare-status-b').textContent='Aguardando...'};const compareCard=document.querySelector('.compare-card'),compareArticle=document.querySelector('article.card');if(compareCard&&compareArticle)compareArticle.appendChild(compareCard);
</script>
