function bubble(a){let x=[...a],o=[];for(let i=0;i<x.length-1;i++){for(let j=0;j<x.length-1-i;j++){o.push({active:[j,j+1],text:`Comparando ${x[j]} e ${x[j+1]}.`});if(x[j]>x[j+1]){[x[j],x[j+1]]=[x[j+1],x[j]];o.push({values:[...x],active:[j,j+1],text:"Trocando."})}}o.push({done:Array.from({length:i+1},(_,k)=>x.length-1-k),text:"Fim da rodada."})}return o}
function selection(a){let x=[...a],o=[];for(let i=0;i<x.length;i++){let m=i;for(let j=i+1;j<x.length;j++){o.push({active:[m,j],text:"Procurando o menor."});if(x[j]<x[m])m=j}if(m!==i){[x[i],x[m]]=[x[m],x[i]];o.push({values:[...x],active:[i,m],text:"Movendo o menor."})}o.push({done:Array.from({length:i+1},(_,k)=>k),text:"Posição concluída."})}return o}
function insertion(a){let x=[...a],o=[];for(let i=1;i<x.length;i++){let key=x[i],j=i-1;o.push({active:[i],text:`Inserindo ${key}.`});while(j>=0&&x[j]>key){x[j+1]=x[j];o.push({values:[...x],active:[j,j+1],text:"Deslocando para a direita."});j--}x[j+1]=key;o.push({values:[...x],done:Array.from({length:i+1},(_,k)=>k),text:"Chave inserida."})}return o}
function quick(a){let x=[...a],o=[];function q(l,r){if(l>=r)return;let p=x[r],i=l;o.push({pivot:[r],text:`Pivô: ${p}.`});for(let j=l;j<r;j++){o.push({active:[j],pivot:[r],text:`Comparando ${x[j]} com o pivô.`});if(x[j]<p){[x[i],x[j]]=[x[j],x[i]];o.push({values:[...x],active:[i,j],pivot:[r],text:"Movendo para a esquerda."});i++}}[x[i],x[r]]=[x[r],x[i]];o.push({values:[...x],done:[i],text:"Pivô posicionado."});q(l,i-1);q(i+1,r)}q(0,x.length-1);return o}
function merge(a){let x=[...a],o=[];for(let size=1;size<x.length;size*=2){for(let l=0;l<x.length;l+=2*size){let m=Math.min(l+size,x.length),r=Math.min(l+2*size,x.length),left=x.slice(l,m),right=x.slice(m,r),k=l;o.push({active:Array.from({length:r-l},(_,i)=>l+i),text:"Intercalando blocos."});while(left.length&&right.length)x[k++]=left[0]<=right[0]?left.shift():right.shift();while(left.length)x[k++]=left.shift();while(right.length)x[k++]=right.shift();o.push({values:[...x],done:Array.from({length:r-l},(_,i)=>l+i),text:"Blocos intercalados."})}}return o}
function linear(a){let target=a[Math.floor(a.length*.65)],o=[];for(let i=0;i<a.length;i++){o.push({active:[i],text:`Verificando ${a[i]}.`});if(a[i]===target){o.push({done:[i],text:`Encontrado: ${target}.`});break}}return o}
function binary(a){let x=[...a].sort((m,n)=>m-n),target=x[Math.floor(x.length*.65)],o=[{values:x,text:`Alvo: ${target}.`}],l=0,r=x.length-1;while(l<=r){let m=Math.floor((l+r)/2);o.push({active:[m],text:`Meio: ${x[m]}.`});if(x[m]===target){o.push({done:[m],text:"Encontrado."});break}if(x[m]<target)l=m+1;else r=m-1}return o}
function graphActions(order){return order.map((v,i)=>({active:[v],done:order.slice(0,i),text:`Visitando ${String.fromCharCode(65+v)}.`})).concat([{done:order,text:"Percurso concluído."}])}
function stackQueue(){return vals.map((_,i)=>({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Processando ${vals[i]}.`}))}
function kmp(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],text:`Comparando posição ${i+1}.`});o.push({done:[10,11,12,13,14],text:"Padrão localizado."});return o}
function fib(){let o=[],a=0,b=1;for(let i=0;i<vals.length;i++){o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`F(${i}) = ${a}`});[a,b]=[b,a+b]}return o}
function queens(){let q=[0,4,7,5,2,6,1,3],o=[];q.forEach((c,r)=>o.push({queen:[r*8+c],done:q.slice(0,r).map((cc,rr)=>rr*8+cc),text:`Rainha na linha ${r+1}.`}));return o}

function heapSort(a){let x=[...a],o=[];for(let end=x.length-1;end>0;end--){let max=0;for(let i=1;i<=end;i++){o.push({active:[max,i],text:"Procurando o maior valor do heap."});if(x[i]>x[max])max=i}[x[max],x[end]]=[x[end],x[max]];o.push({values:[...x],active:[max,end],done:Array.from({length:x.length-end},(_,k)=>end+k),text:"Movendo o maior para o fim."})}return o}
function shellSort(a){let x=[...a],o=[];for(let gap=Math.floor(x.length/2);gap>0;gap=Math.floor(gap/2)){for(let i=gap;i<x.length;i++){let temp=x[i],j=i;o.push({active:[i,i-gap],text:`Comparando com intervalo ${gap}.`});while(j>=gap&&x[j-gap]>temp){x[j]=x[j-gap];o.push({values:[...x],active:[j,j-gap],text:"Deslocando pelo intervalo."});j-=gap}x[j]=temp;o.push({values:[...x],active:[j],text:"Inserindo no grupo."})}}o.push({values:x,done:x.map((_,i)=>i),text:"Shell Sort concluído."});return o}
function countingSort(a){let x=[...a],o=[],max=Math.max(...x),count=Array(max+1).fill(0);x.forEach((v,i)=>{count[v]++;o.push({active:[i],text:`Contando ocorrência de ${v}.`})});let k=0;for(let v=0;v<count.length;v++)while(count[v]--){x[k]=v;o.push({values:[...x],active:[k],done:Array.from({length:k},(_,i)=>i),text:`Escrevendo ${v} na saída.`});k++}return o}
function jumpSearch(a){let x=[...a].sort((m,n)=>m-n),target=x[Math.floor(x.length*.7)],step=Math.max(1,Math.floor(Math.sqrt(x.length))),o=[{values:x,text:`Alvo: ${target}.`}],prev=0;while(prev<x.length&&x[Math.min(prev+step,x.length)-1]<target){let idx=Math.min(prev+step,x.length)-1;o.push({active:[idx],text:`Salto até ${x[idx]}.`});prev+=step}for(let i=prev;i<Math.min(prev+step,x.length);i++){o.push({active:[i],text:`Busca linear no bloco: ${x[i]}.`});if(x[i]===target){o.push({done:[i],text:"Encontrado."});break}}return o}
function interpolation(a){let x=[...a].sort((m,n)=>m-n),target=x[Math.floor(x.length*.65)],o=[{values:x,text:`Alvo: ${target}.`}],lo=0,hi=x.length-1;while(lo<=hi&&target>=x[lo]&&target<=x[hi]){let pos=lo+Math.floor(((target-x[lo])*(hi-lo))/Math.max(1,x[hi]-x[lo]));o.push({active:[pos],text:`Posição estimada: ${pos+1}.`});if(x[pos]===target){o.push({done:[pos],text:"Encontrado pela interpolação."});break}if(x[pos]<target)lo=pos+1;else hi=pos-1}return o}
function bellman(){let order=[0,1,2,6,3,5,7,4],o=[];for(let pass=0;pass<2;pass++)order.forEach((v,i)=>o.push({active:[v],done:order.slice(0,i),text:`Relaxando arestas — rodada ${pass+1}.`}));return o}
function prim(){let order=[0,1,6,2,5,3,4,7];return order.map((v,i)=>({active:[v],done:order.slice(0,i),text:"Adicionando a menor aresta segura."}))}
function kruskal(){let order=[1,6,2,5,0,7,3,4];return order.map((v,i)=>({active:[v],done:order.slice(0,i),text:"Selecionando aresta sem formar ciclo."}))}
function bst(){let o=[];vals.forEach((v,i)=>o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Inserindo ${v} na árvore binária.`}));return o}
function avl(){let o=[];vals.forEach((v,i)=>{o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Inserindo ${v}.`});if(i>2&&i%3===0)o.push({active:[i-1,i],text:"Aplicando rotação para balancear."})});return o}
function trie(){let o=[];vals.forEach((_,i)=>o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Criando caminho para prefixo ${i+1}.`}));return o}
function hashTable(){let o=[];vals.forEach((v,i)=>{let slot=(v*3)%vals.length;o.push({active:[slot],done:Array.from({length:i},(_,k)=>(vals[k]*3)%vals.length),text:`hash(${v}) → posição ${slot}.`})});return o}
function rabinKarp(){let o=[];for(let i=0;i<vals.length-4;i++)o.push({active:[i,i+1,i+2,i+3],text:`Atualizando hash da janela ${i+1}.`});o.push({done:[10,11,12,13],text:"Hash confirmado: padrão encontrado."});return o}
function coinChange(){let target=12,o=[];for(let amount=1;amount<=target;amount++)o.push({active:[amount%vals.length],done:Array.from({length:amount-1},(_,k)=>k%vals.length),text:`Calculando menor número de moedas para ${amount}.`});return o}
function sudoku(){let solution=[0,4,8,12,16,20,24,28,32,36,40,44,48,52,56,60,64,68,72,76,80],o=[];solution.forEach((cell,i)=>o.push({queen:[cell],done:solution.slice(0,i),text:`Preenchendo célula ${cell+1}.`}));return o}


function exponentialSearch(a){let x=[...a].sort((m,n)=>m-n),target=x[Math.floor(x.length*.7)],o=[{values:x,text:`Alvo: ${target}.`}],bound=1;while(bound<x.length&&x[bound]<target){o.push({active:[bound],text:`Expandindo intervalo até ${bound}.`});bound*=2}let l=Math.floor(bound/2),r=Math.min(bound,x.length-1);while(l<=r){let m=Math.floor((l+r)/2);o.push({active:[m],text:`Busca binária em ${x[m]}.`});if(x[m]===target){o.push({done:[m],text:"Encontrado."});break}if(x[m]<target)l=m+1;else r=m-1}return o}
function ternarySearch(a){let x=[...a].sort((m,n)=>m-n),target=x[Math.floor(x.length*.6)],o=[{values:x,text:`Alvo: ${target}.`}],l=0,r=x.length-1;while(l<=r){let m1=l+Math.floor((r-l)/3),m2=r-Math.floor((r-l)/3);o.push({active:[m1,m2],text:`Terços: ${x[m1]} e ${x[m2]}.`});if(x[m1]===target){o.push({done:[m1],text:"Encontrado."});break}if(x[m2]===target){o.push({done:[m2],text:"Encontrado."});break}if(target<x[m1])r=m1-1;else if(target>x[m2])l=m2+1;else{l=m1+1;r=m2-1}}return o}
function fibonacciSearch(a){let x=[...a].sort((m,n)=>m-n),target=x[Math.floor(x.length*.65)],o=[{values:x,text:`Alvo: ${target}.`}],offset=-1,f2=0,f1=1,f=f1+f2;while(f<x.length){f2=f1;f1=f;f=f1+f2}while(f>1){let i=Math.min(offset+f2,x.length-1);o.push({active:[i],text:`Comparando na posição Fibonacci ${i+1}.`});if(x[i]<target){f=f1;f1=f2;f2=f-f1;offset=i}else if(x[i]>target){f=f2;f1=f1-f2;f2=f-f1}else{o.push({done:[i],text:"Encontrado."});break}}return o}
function floydWarshall(){let o=[];for(let k=0;k<8;k++)for(let i=0;i<8;i++)o.push({active:[i],done:Array.from({length:k},(_,x)=>x),text:`Usando ${String.fromCharCode(65+k)} como intermediário.`});return o}
function topo(){let order=[7,0,6,1,2,5,3,4];return order.map((v,i)=>({active:[v],done:order.slice(0,i),text:"Removendo vértice sem dependências."}))}
function tarjan(){let order=[0,1,2,3,4,5,6,7];return order.map((v,i)=>({active:[v],done:order.slice(0,i),text:`Atualizando índice e low-link de ${String.fromCharCode(65+v)}.`}))}
function balancedTree(kind){let o=[];vals.forEach((v,i)=>{o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Inserindo ${v} em ${kind}.`});if(i>2&&i%3===0)o.push({active:[i-1,i],text:"Reorganizando nós para manter equilíbrio."})});return o}
function segmentTree(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Construindo intervalo até ${i+1}.`});o.push({active:[2,3,4],text:"Consultando soma de um intervalo."});return o}
function fenwick(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Atualizando índices responsáveis por ${i+1}.`});return o}
function boyerMoore(){let o=[];for(let i=vals.length-5;i>=0;i--)o.push({active:[i,i+1,i+2,i+3],text:`Comparando janela da direita para a esquerda: ${i+1}.`});o.push({done:[10,11,12,13],text:"Padrão encontrado."});return o}
function zAlgorithm(){let o=[];for(let i=1;i<vals.length;i++)o.push({active:[0,i],done:Array.from({length:Math.max(0,i-1)},(_,k)=>k+1),text:`Calculando Z[${i}].`});return o}
function lcs(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Atualizando melhor subsequência comum até ${i+1}.`});return o}
function lis(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Calculando LIS terminando em ${i+1}.`});return o}


function deque(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:i%2===0?`Inserindo ${vals[i]} no início.`:`Inserindo ${vals[i]} no fim.`});return o}
function linkedList(doubleLinked=false){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:doubleLinked?`Ligando ${vals[i]} ao anterior e ao próximo.`:`Ligando ${vals[i]} ao próximo nó.`});return o}
function unionFind(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Unindo conjunto de ${vals[i]} com seu representante.`});return o}
function lru(){let o=[];let order=[];vals.forEach((v,i)=>{order.unshift(i);if(order.length>5)order.pop();o.push({active:[i],done:[...order],text:`Acessando ${v} e movendo para a frente do cache.`})});return o}
function bloom(){let o=[];vals.forEach((v,i)=>{let a=(v*3)%vals.length,b=(v*7)%vals.length;o.push({active:[a,b],done:Array.from({length:i},(_,k)=>(vals[k]*3)%vals.length),text:`Marcando bits de ${v} nas posições ${a} e ${b}.`})});return o}
function priorityQueue(){let o=[];let x=[...vals];for(let i=0;i<x.length;i++){let max=i;for(let j=i+1;j<x.length;j++)if(x[j]>x[max])max=j;[x[i],x[max]]=[x[max],x[i]];o.push({values:[...x],active:[i,max],done:Array.from({length:i},(_,k)=>k),text:"Removendo o item de maior prioridade."})}return o}
function aho(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:Math.max(0,i-2)},(_,k)=>k),text:`Avançando no autômato na posição ${i+1}.`});return o}
function suffixArray(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Ordenando sufixo iniciado em ${i+1}.`});return o}
function lcp(){let o=[];for(let i=1;i<vals.length;i++)o.push({active:[i-1,i],done:Array.from({length:i-1},(_,k)=>k),text:`Comparando prefixos dos sufixos ${i} e ${i+1}.`});return o}
function manacher(){let center=Math.floor(vals.length/2),o=[];for(let r=0;r<=center;r++){let idx=[center-r,center+r].filter(i=>i>=0&&i<vals.length);o.push({active:idx,done:Array.from({length:r},(_,k)=>center-k).filter(i=>i>=0),text:`Expandindo palíndromo com raio ${r}.`})}return o}
function knapsack(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Avaliando incluir ou não o item ${i+1}.`});return o}
function matrixChain(){let o=[];for(let len=2;len<=vals.length;len++)o.push({active:[len-2,len-1],done:Array.from({length:len-2},(_,k)=>k),text:`Calculando melhor custo para cadeia de tamanho ${len}.`});return o}
function rodCutting(){let o=[];for(let i=1;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Calculando melhor corte para comprimento ${i}.`});return o}
function editDistance(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Calculando custo de edição na posição ${i+1}.`});return o}


function radixSort(a){let x=[...a],o=[];for(let exp=1;Math.floor(Math.max(...x)/exp)>0;exp*=10){let buckets=Array.from({length:10},()=>[]);x.forEach((v,i)=>{let d=Math.floor(v/exp)%10;buckets[d].push(v);o.push({active:[i],text:`Dígito ${d} de ${v}.`})});x=buckets.flat();o.push({values:[...x],done:[],text:`Reorganizando pelo dígito ${exp}.`})}o.push({values:x,done:x.map((_,i)=>i),text:"Radix Sort concluído."});return o}
function cocktailSort(a){let x=[...a],o=[],start=0,end=x.length-1,swapped=true;while(swapped){swapped=false;for(let i=start;i<end;i++){o.push({active:[i,i+1],text:"Varredura da esquerda para a direita."});if(x[i]>x[i+1]){[x[i],x[i+1]]=[x[i+1],x[i]];o.push({values:[...x],active:[i,i+1],text:"Trocando."});swapped=true}}if(!swapped)break;swapped=false;end--;for(let i=end;i>start;i--){o.push({active:[i-1,i],text:"Varredura da direita para a esquerda."});if(x[i-1]>x[i]){[x[i-1],x[i]]=[x[i],x[i-1]];o.push({values:[...x],active:[i-1,i],text:"Trocando."});swapped=true}}start++}return o}
function matrixSearch(a){let x=[...a].sort((m,n)=>m-n),target=x[Math.floor(x.length*.6)],o=[{values:x,text:`Alvo: ${target}.`}];for(let i=x.length-1;i>=0;i--){o.push({active:[i],text:`Verificando posição ${i+1}.`});if(x[i]===target){o.push({done:[i],text:"Encontrado na matriz ordenada."});break}}return o}
function hashSearch(){let target=vals[Math.floor(vals.length*.6)],slot=(target*3)%vals.length;return [{active:[slot],text:`hash(${target}) = ${slot}.`},{done:[slot],text:"Registro localizado pela chave."}]}
function localSearch(){let o=[],best=0;for(let i=1;i<vals.length;i++){o.push({active:[best,i],text:"Comparando vizinhos da solução atual."});if(vals[i]>vals[best])best=i}o.push({done:[best],text:"Melhor solução local encontrada."});return o}
function splay(){let o=[];vals.forEach((v,i)=>{o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Acessando ${v}.`});if(i>0)o.push({active:[i-1,i],text:"Rotacionando nó acessado para a raiz."})});return o}
function naiveString(){let o=[];for(let i=0;i<vals.length-4;i++)o.push({active:[i,i+1,i+2,i+3],text:`Comparando padrão na posição ${i+1}.`});o.push({done:[10,11,12,13],text:"Padrão encontrado."});return o}
function subsetSum(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Testando incluir o valor ${vals[i]}.`});return o}
function lps(){let o=[];for(let l=0,r=vals.length-1;l<=r;l++,r--)o.push({active:l===r?[l]:[l,r],done:Array.from({length:l},(_,k)=>k).concat(Array.from({length:l},(_,k)=>vals.length-1-k)),text:"Comparando extremidades para formar palíndromo."});return o}
function knightTour(){let order=[0,17,34,51,60,43,26,9,2,19];return order.map((v,i)=>({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Movimento do cavalo para a casa ${v+1}.`}))}
function maze(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Explorando caminho ${i+1}.`});return o}
function graphColoring(){let colors=[0,1,2,0,1,2,0,1,2,0],o=[];colors.forEach((c,i)=>o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Atribuindo cor ${c+1} ao vértice ${i+1}.`}));return o}
function permutations(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Fixando elemento ${vals[i]} e permutando o restante.`});return o}
function combinations(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Incluindo ou ignorando ${vals[i]} na combinação.`});return o}


function astar(){let order=[0,1,6,2,5,3,4],o=[];order.forEach((v,i)=>o.push({active:[v],done:order.slice(0,i),text:`Escolhendo o nó com menor f = g + h: ${String.fromCharCode(65+v)}.`}));return o}
function binaryHeap(){let x=[...vals],o=[];for(let i=1;i<x.length;i++){let c=i,p=Math.floor((c-1)/2);o.push({active:[c,p],text:`Comparando filho ${x[c]} com pai ${x[p]}.`});while(c>0&&x[c]>x[p]){[x[c],x[p]]=[x[p],x[c]];o.push({values:[...x],active:[c,p],text:"Subindo o maior valor no heap."});c=p;p=Math.floor((c-1)/2)}}return o}
function hanoi(){let moves=[[0,2],[0,1],[2,1],[0,2],[1,0],[1,2],[0,2]],o=[];moves.forEach((m,i)=>o.push({active:[i%vals.length],done:Array.from({length:i},(_,k)=>k%vals.length),text:`Movimento ${i+1}: haste ${m[0]+1} → ${m[1]+1}.`}));return o}
function wordSearch(){let word=[0,1,2,3,4,5],o=[];word.forEach((v,i)=>o.push({active:[v],done:word.slice(0,i),text:`Procurando a letra ${i+1} em células vizinhas.`}));return o}
function graham(){let order=[0,2,5,7,9,6,3,1],o=[];order.forEach((v,i)=>o.push({active:[v],done:order.slice(0,i),text:"Verificando orientação e mantendo a borda convexa."}));return o}
function jarvis(){let order=[0,3,6,9,8,5,2,1],o=[];order.forEach((v,i)=>o.push({active:[v],done:order.slice(0,i),text:"Escolhendo o ponto mais à esquerda na próxima direção."}));return o}
function closestPair(){let o=[];for(let i=0;i<vals.length-1;i++)o.push({active:[i,i+1],done:Array.from({length:i},(_,k)=>k),text:`Comparando a distância entre os pontos ${i+1} e ${i+2}.`});return o}
function segmentIntersection(){return [{active:[1,2],text:"Calculando a orientação do primeiro segmento."},{active:[4,5],text:"Calculando a orientação do segundo segmento."},{done:[1,2,4,5],text:"Os segmentos se cruzam."}]}
function pointInPolygon(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Lançando um raio e contando cruzamentos na aresta ${i+1}.`});return o}
function rotatingCalipers(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i,(i+5)%vals.length],done:Array.from({length:i},(_,k)=>k),text:"Girando as linhas de apoio para medir o diâmetro."});return o}
function sweepLine(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Movendo a linha de varredura pelo evento ${i+1}.`});return o}
function triangulation(){let o=[];for(let i=1;i<vals.length-1;i++)o.push({active:[0,i,i+1],done:Array.from({length:i-1},(_,k)=>k+1),text:"Adicionando uma diagonal válida ao polígono."});return o}
function voronoi(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Expandindo a região mais próxima do ponto ${i+1}.`});return o}
function douglasPeucker(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[0,i,vals.length-1],done:Array.from({length:i},(_,k)=>k),text:"Medindo a distância do ponto à linha simplificada."});return o}
function huffman(){let weights=[...vals],o=[];while(weights.length>1){weights.sort((a,b)=>a-b);let a=weights.shift(),b=weights.shift(),sum=a+b;weights.push(sum);o.push({active:[0,1],text:`Combinando frequências ${a} e ${b} → ${sum}.`})}o.push({done:vals.map((_,i)=>i),text:"Árvore de Huffman concluída."});return o}
function rle(){let o=[];for(let i=0;i<vals.length;i++){let j=i;while(j+1<vals.length&&vals[j+1]===vals[i])j++;o.push({active:Array.from({length:j-i+1},(_,k)=>i+k),done:Array.from({length:i},(_,k)=>k),text:`Codificando sequência de ${j-i+1} ocorrência(s).`});i=j}return o}
function lz77(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[Math.max(0,i-2),i],done:Array.from({length:i},(_,k)=>k),text:"Procurando repetição na janela anterior."});return o}
function lzw(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Adicionando sequência ${i+1} ao dicionário.`});return o}
function bwt(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Gerando e ordenando rotação ${i+1}.`});return o}
function crc(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:"Aplicando divisão polinomial XOR."});return o}
function base64(){let o=[];for(let i=0;i<vals.length;i+=3)o.push({active:[i,Math.min(i+1,vals.length-1),Math.min(i+2,vals.length-1)],done:Array.from({length:i},(_,k)=>k),text:"Convertendo 3 bytes em 4 símbolos Base64."});return o}
function reservoir(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:i<3?Array.from({length:i},(_,k)=>k):[0,1,2],text:i<3?"Preenchendo o reservatório.":"Decidindo aleatoriamente se o item entra na amostra."});return o}
function fisherYates(){let x=[...vals],o=[];for(let i=x.length-1;i>0;i--){let j=(i*7+3)%(i+1);[x[i],x[j]]=[x[j],x[i]];o.push({values:[...x],active:[i,j],done:Array.from({length:x.length-1-i},(_,k)=>x.length-1-k),text:`Trocando posição ${i+1} com ${j+1}.`})}return o}
function euclid(){let a=84,b=30,o=[];while(b!==0){o.push({active:[a%vals.length,b%vals.length],text:`${a} mod ${b} = ${a%b}.`});[a,b]=[b,a%b]}o.push({done:[a%vals.length],text:`MDC = ${a}.`});return o}

function generic(){return vals.map((_,i)=>({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Etapa ${i+1}.`}))}
function build(){if(cur.name==="Bubble Sort")return bubble(vals);if(cur.name==="Selection Sort")return selection(vals);if(cur.name==="Insertion Sort")return insertion(vals);if(cur.name==="Merge Sort")return merge(vals);if(cur.name==="Quick Sort")return quick(vals);if(cur.name==="Busca Linear")return linear(vals);if(cur.name==="Busca Binária")return binary(vals);if(cur.name==="BFS")return graphActions([0,1,6,7,2,5,3,4]);if(cur.name==="DFS")return graphActions([0,1,2,3,4,5,6,7]);if(cur.name==="Dijkstra")return graphActions([0,1,6,2,7,5,3,4]);if(cur.name==="Pilha"||cur.name==="Fila")return stackQueue();if(cur.name==="KMP")return kmp();if(cur.name==="Fibonacci DP")return fib();if(cur.name==="N-Rainhas")return queens();if(cur.name==="Heap Sort")return heapSort(vals);if(cur.name==="Shell Sort")return shellSort(vals);if(cur.name==="Counting Sort")return countingSort(vals);if(cur.name==="Jump Search")return jumpSearch(vals);if(cur.name==="Interpolation Search")return interpolation(vals);if(cur.name==="Bellman-Ford")return bellman();if(cur.name==="Prim")return prim();if(cur.name==="Kruskal")return kruskal();if(cur.name==="Árvore binária de busca")return bst();if(cur.name==="AVL")return avl();if(cur.name==="Trie")return trie();if(cur.name==="Hash Table")return hashTable();if(cur.name==="Rabin-Karp")return rabinKarp();if(cur.name==="Coin Change")return coinChange();if(cur.name==="Sudoku Solver")return sudoku();if(cur.name==="Exponential Search")return exponentialSearch(vals);if(cur.name==="Busca Ternária")return ternarySearch(vals);if(cur.name==="Fibonacci Search")return fibonacciSearch(vals);if(cur.name==="Floyd-Warshall")return floydWarshall();if(cur.name==="Ordenação Topológica")return topo();if(cur.name==="Tarjan SCC")return tarjan();if(cur.name==="Red-Black Tree")return balancedTree("Red-Black Tree");if(cur.name==="B-Tree")return balancedTree("B-Tree");if(cur.name==="B+ Tree")return balancedTree("B+ Tree");if(cur.name==="Segment Tree")return segmentTree();if(cur.name==="Fenwick Tree")return fenwick();if(cur.name==="Boyer-Moore")return boyerMoore();if(cur.name==="Z-Algorithm")return zAlgorithm();if(cur.name==="LCS")return lcs();if(cur.name==="LIS")return lis();if(cur.name==="Deque")return deque();if(cur.name==="Lista ligada")return linkedList(false);if(cur.name==="Lista duplamente ligada")return linkedList(true);if(cur.name==="Union-Find")return unionFind();if(cur.name==="LRU Cache")return lru();if(cur.name==="Bloom Filter")return bloom();if(cur.name==="Priority Queue")return priorityQueue();if(cur.name==="Aho-Corasick")return aho();if(cur.name==="Suffix Array")return suffixArray();if(cur.name==="LCP Array")return lcp();if(cur.name==="Manacher")return manacher();if(cur.name==="Mochila 0/1")return knapsack();if(cur.name==="Matrix Chain")return matrixChain();if(cur.name==="Rod Cutting")return rodCutting();if(cur.name==="Edit Distance")return editDistance();if(cur.name==="Radix Sort")return radixSort(vals);if(cur.name==="Cocktail Sort")return cocktailSort(vals);if(cur.name==="Busca em matriz")return matrixSearch(vals);if(cur.name==="Busca por hashing")return hashSearch();if(cur.name==="Busca gulosa local")return localSearch();if(cur.name==="Splay Tree")return splay();if(cur.name==="Busca ingênua")return naiveString();if(cur.name==="Distância de edição")return editDistance();if(cur.name==="Subset Sum")return subsetSum();if(cur.name==="LPS")return lps();if(cur.name==="Knight's Tour")return knightTour();if(cur.name==="Rat in a Maze")return maze();if(cur.name==="Coloração de grafos")return graphColoring();if(cur.name==="Permutações")return permutations();if(cur.name==="Combinações")return combinations();if(cur.name==="A*")return astar();if(cur.name==="Heap binário")return binaryHeap();if(cur.name==="Torre de Hanói")return hanoi();if(cur.name==="Word Search")return wordSearch();if(cur.name==="Graham Scan")return graham();if(cur.name==="Jarvis March")return jarvis();if(cur.name==="Closest Pair")return closestPair();if(cur.name==="Interseção de segmentos")return segmentIntersection();if(cur.name==="Point in Polygon")return pointInPolygon();if(cur.name==="Rotating Calipers")return rotatingCalipers();if(cur.name==="Sweep Line")return sweepLine();if(cur.name==="Triangulação")return triangulation();if(cur.name==="Voronoi")return voronoi();if(cur.name==="Douglas-Peucker")return douglasPeucker();if(cur.name==="Huffman Coding")return huffman();if(cur.name==="Run-Length Encoding")return rle();if(cur.name==="LZ77")return lz77();if(cur.name==="LZW")return lzw();if(cur.name==="Burrows-Wheeler")return bwt();if(cur.name==="CRC")return crc();if(cur.name==="Base64")return base64();if(cur.name==="Reservoir Sampling")return reservoir();if(cur.name==="Fisher-Yates")return fisherYates();if(cur.name==="Euclides — MDC")return euclid();return generic()}
function render(s={}){$("visual").innerHTML="";if(["sorting","search"].includes(cur.category)){let b=document.createElement("div");b.className="bars";let m=Math.max(...vals,1);vals.forEach((v,i)=>{let e=document.createElement("div");e.className="bar";e.dataset.v=v;e.style.height=`${Math.max(10,v/m*100)}%`;if((s.active||[]).includes(i))e.classList.add("active");if((s.done||[]).includes(i))e.classList.add("done");if((s.pivot||[]).includes(i))e.classList.add("pivot");b.appendChild(e)});$("visual").appendChild(b);return}
if(["BFS","DFS","Dijkstra","A*","Bellman-Ford","Prim","Kruskal","Floyd-Warshall","Ordenação Topológica","Tarjan SCC"].includes(cur.name)){let g=document.createElement("div");g.className="graph";graphEdges.forEach(([a,b])=>{let e=document.createElement("div");e.className="edge";let [x1,y1]=graphPos[a],[x2,y2]=graphPos[b],dx=x2-x1,dy=y2-y1;e.style.left=x1+"%";e.style.top=y1+"%";e.style.width=Math.hypot(dx,dy)+"%";e.style.transform=`rotate(${Math.atan2(dy,dx)*180/Math.PI}deg)`;g.appendChild(e)});graphPos.forEach((p,i)=>{let n=document.createElement("div");n.className="g-node";n.textContent=String.fromCharCode(65+i);n.style.left=p[0]+"%";n.style.top=p[1]+"%";if((s.active||[]).includes(i))n.classList.add("active");if((s.done||[]).includes(i))n.classList.add("done");g.appendChild(n)});$("visual").appendChild(g);return}
if(cur.name==="N-Rainhas"||cur.name==="Sudoku Solver"){let g=document.createElement("div");g.className="grid";if(cur.name==="Sudoku Solver")g.style.gridTemplateColumns="repeat(9, 32px)";for(let i=0;i<(cur.name==="Sudoku Solver"?81:64);i++){let c=document.createElement("div");c.className="cell";if((s.queen||[]).includes(i)){c.classList.add("queen","active");c.textContent=cur.name==="Sudoku Solver"?String((i%9)+1):"♛"}if((s.done||[]).includes(i)){c.classList.add("done");c.textContent=cur.name==="Sudoku Solver"?String((i%9)+1):"♛"}g.appendChild(c)}$("visual").appendChild(g);return}
let n=document.createElement("div");n.className="nodes";vals.forEach((v,i)=>{let e=document.createElement("div");e.className="node";e.textContent=typeof v==="string"?v:(cur.name==="Fibonacci DP"?`F${v}`:v);if((s.active||[]).includes(i))e.classList.add("active");if((s.done||[]).includes(i))e.classList.add("done");n.appendChild(e)});$("visual").appendChild(n)}
function prep(){clearTimeout(timer);playing=false;$("play").textContent="▶ Executar";vals=input();acts=build();pos=0;render();$("status").textContent="Pronto."}
function apply(a){if(a.values)vals=[...a.values];render(a);$("status").textContent=a.text;[...$("steps").children].forEach((x,i)=>x.classList.toggle("active",i===Math.min(3,Math.floor(pos/Math.max(1,acts.length/4)))))}
function next(){if(pos>=acts.length){playing=false;$("play").textContent="▶ Executar";return false}apply(acts[pos++]);return true}
function loop(){if(!playing)return;if(next())timer=setTimeout(loop,980-Number($("speed").value))}
function select(id){cur=algorithms.find(a=>a.id===id);document.querySelectorAll(".algo").forEach(b=>b.classList.toggle("active",b.dataset.id===id));$("cat").textContent=categories[cur.category].toUpperCase();$("title").textContent=cur.name;$("desc").textContent=cur.description;$("cx").textContent=cur.complexity;$("ptname").textContent=cur.portugueseName;$("meaning").textContent=cur.meaning;$("realUse").textContent=cur.realUse;$("code").textContent=`// ${cur.name}\nfunção executar(entrada)\n  preparar dados\n  repetir etapas\n  atualizar visualização\n  retornar resultado`;$("steps").innerHTML=["Preparar entrada","Executar decisões","Atualizar estado","Concluir"].map(x=>`<li>${x}</li>`).join("");$("note").textContent=cur.dedicated?"Esta animação é exclusiva para este algoritmo.":"Este algoritmo ainda usa o motor genérico da categoria.";prep()}
document.querySelectorAll(".algo").forEach(b=>b.addEventListener("click",()=>select(b.dataset.id)));$("new").onclick=prep;$("reset").onclick=prep;$("step").onclick=()=>{playing=false;clearTimeout(timer);next()};$("play").onclick=()=>{playing=!playing;$("play").textContent=playing?"❚❚ Pausar":"▶ Continuar";playing?loop():clearTimeout(timer)};$("filter").oninput=e=>{let q=e.target.value.toLowerCase();document.querySelectorAll(".algo").forEach(b=>b.hidden=!b.dataset.name.includes(q));document.querySelectorAll(".cat").forEach(s=>s.hidden=[...s.querySelectorAll(".algo")].every(b=>b.hidden))};select("a0");
