<script is:inline>
(()=>{
const sim=document.querySelector('.snack-sim');
if(!sim)return;
sim.querySelector('.sort-route-scene')?.remove();
sim.querySelector('.snack-controls label:first-child')?.remove();
const names=['Hambúrguer artesanal','Pizza Margherita','Batata frita','Sushi vegano','Taco mexicano','Coxinha','Salada tropical','Curry indiano','Bife grelhado','Donut'];
const values=[100,10,1,100,10,1,10,100,100,1];
const diet=['porcaria','vegetariana','porcaria','vegana','porcaria','porcaria','vegana','vegana','porcaria','vegetariana'];
const type=['artesanal','estrangeira','fast food','estrangeira','estrangeira','fast food','artesanal','estrangeira','artesanal','fast food'];
const methods={linear:'Busca linear',binary:'Busca binária',quick:'Quick Sort',merge:'Merge Sort',bubble:'Bubble Sort',tim:'Tim Sort',heap:'Heap Sort'};
const orderFor=(method,field)=>{
const order=names.map((_,i)=>i);
if(method==='linear')return order;
return order.sort((a,b)=>{
if(field==='price')return values[a]-values[b];
if(field==='diet')return diet[a].localeCompare(diet[b],'pt-BR');
return type[a].localeCompare(type[b],'pt-BR');
});
};
const scene=document.createElement('section');
scene.className='batch-route-scene';
scene.innerHTML='<div class="scene-title">10 comidas organizadas em 2 prateleiras de 140 posições</div><div class="scene-subtitle">O mesmo lote sai do balcão. Cada atendente segue a ordem produzida pelo seu algoritmo, acende a posição encontrada e volta.</div><div class="batch-stage"><div class="batch-shelf shelf-left"><b id="batch-title-a">PRATELEIRA A</b><small id="batch-info-a"></small><div id="batch-grid-a" class="batch-grid"></div></div><div class="batch-counter"><span>🧑‍🍳</span><b>BALCÃO</b><small id="batch-counter-state">10 comidas aguardando</small></div><div class="batch-shelf shelf-right"><b id="batch-title-b">PRATELEIRA B</b><small id="batch-info-b"></small><div id="batch-grid-b" class="batch-grid"></div></div><div class="batch-path path-left"><i id="batch-runner-a">🏃‍♂️</i></div><div class="batch-path path-right"><i id="batch-runner-b">🏃‍♀️</i></div></div><div class="batch-readout"><div><b id="batch-label-a">A</b><span id="batch-message-a">Aguardando.</span></div><div><b id="batch-label-b">B</b><span id="batch-message-b">Aguardando.</span></div></div><div id="batch-status" class="batch-status">Preparando as duas prateleiras.</div>';
sim.appendChild(scene);
const field=sim.querySelector('#snack-field');
const methodA=sim.querySelector('#snack-a');
const methodB=sim.querySelector('#snack-b');
const run=sim.querySelector('#snack-run');
const slots=[6,20,34,48,62,76,90,104,118,132];
let timer=null;
const grid=(id,order)=>{
const el=scene.querySelector(id);el.innerHTML='';
for(let i=0;i<140;i++){
const cell=document.createElement('span');cell.className='batch-cell';cell.dataset.slot=i;
const p=slots.indexOf(i);
if(p>=0)cell.dataset.food=String(order[p]);
cell.setAttribute('aria-label',p>=0?names[order[p]]:'posição vazia');
el.appendChild(cell);
}
};
const clearGlow=()=>scene.querySelectorAll('.batch-cell').forEach(x=>x.classList.remove('picked','current'));
const glow=(id,food,kind)=>{const cell=scene.querySelector(id+' [data-food="'+food+'"]');if(cell)cell.classList.add(kind);};
const setup=()=>{
const fieldName=field.value;
const a=orderFor(methodA.value,fieldName),b=orderFor(methodB.value,fieldName);
grid('#batch-grid-a',a);grid('#batch-grid-b',b);clearGlow();
scene.querySelector('#batch-title-a').textContent='PRATELEIRA A · '+methods[methodA.value];
scene.querySelector('#batch-title-b').textContent='PRATELEIRA B · '+methods[methodB.value];
scene.querySelector('#batch-info-a').textContent='140 quadrados · 10 posições ocupadas';
scene.querySelector('#batch-info-b').textContent='140 quadrados · 10 posições ocupadas';
scene.querySelector('#batch-label-a').textContent='Atendente A · '+methods[methodA.value];
scene.querySelector('#batch-label-b').textContent='Atendente B · '+methods[methodB.value];
return [a,b];
};
const play=()=>{
clearInterval(timer);const orders=setup(),a=orders[0],b=orders[1];let tick=0;
const runnerA=scene.querySelector('#batch-runner-a'),runnerB=scene.querySelector('#batch-runner-b');
runnerA.style.left='100%';runnerB.style.left='0%';
scene.querySelector('#batch-counter-state').textContent='10 comidas aguardando';
timer=setInterval(()=>{
const item=Math.floor(tick/9),phase=tick%9;
if(item>=10){clearInterval(timer);scene.querySelector('#batch-status').textContent='Lote completo: as 10 comidas voltaram ao balcão.';scene.querySelector('#batch-message-a').textContent='Entregou as 10 comidas.';scene.querySelector('#batch-message-b').textContent='Entregou as 10 comidas.';scene.querySelector('#batch-counter-state').textContent='10 comidas entregues';return;}
const foodA=a[item],foodB=b[item];
if(phase===0){scene.querySelectorAll('.batch-cell.current').forEach(x=>x.classList.remove('current'));scene.querySelector('#batch-status').textContent='Atendentes saindo do mesmo balcão para buscar a comida '+(item+1)+' de 10.';}
if(phase<=3){const progress=(phase+1)*25;runnerA.style.left=(100-progress)+'%';runnerB.style.left=progress+'%';scene.querySelector('#batch-message-a').textContent='Indo para a prateleira A: '+(item+1)+'/10';scene.querySelector('#batch-message-b').textContent='Indo para a prateleira B: '+(item+1)+'/10';}
if(phase===4){glow('#batch-grid-a',String(foodA),'current');glow('#batch-grid-b',String(foodB),'current');scene.querySelector('#batch-status').textContent='Pegando '+names[foodA]+' na A e '+names[foodB]+' na B.';scene.querySelector('#batch-message-a').textContent='Pegou a posição iluminada.';scene.querySelector('#batch-message-b').textContent='Pegou a posição iluminada.';}
