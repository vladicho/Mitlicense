<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MITLicense — 100 Algoritmos</title>
<style is:global>
:root{--bg:#090b12;--p:#141925;--p2:#1b2231;--l:#2a354b;--t:#f7f9fc;--m:#98a4b8;--a:#7c5cff;--a2:#2dd4bf;--ok:#34c77b;--w:#f4b942;--danger:#ef5f67}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--t);font-family:system-ui,sans-serif}.wrap{width:min(1240px,calc(100% - 20px));margin:auto}
header{position:sticky;top:0;z-index:5;background:#090b12e8;border-bottom:1px solid var(--l)}.top{min-height:64px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:900}.muted{color:var(--m)}
main{padding:34px 0}h1{font-size:clamp(2.4rem,7vw,5rem);line-height:.95;letter-spacing:-.06em;margin:0 0 10px}.hero p{color:var(--m);max-width:800px}.layout{display:grid;grid-template-columns:320px 1fr;gap:18px;align-items:start}.card{background:var(--p);border:1px solid var(--l);border-radius:18px}
aside{position:sticky;top:82px;max-height:calc(100vh - 95px);overflow:auto;padding:12px}.search{width:100%;padding:11px;border:1px solid var(--l);border-radius:11px;background:var(--p2);color:var(--t)}
h3{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--m);margin:13px 7px 6px}.algo{width:100%;text-align:left;padding:9px 10px;border:1px solid transparent;border-radius:10px;background:transparent;color:var(--t)}.algo.active{background:#7c5cff22;border-color:#7c5cff88}.algo small{display:block;color:var(--m)}.algo .tag{display:inline-block;margin-top:4px;font-size:.65rem;color:#9af5eb}
.head{padding:18px;border-bottom:1px solid var(--l);display:flex;justify-content:space-between;gap:12px}.head h2{margin:3px 0 4px}.badge{padding:7px 10px;border:1px solid #2dd4bf66;border-radius:999px;color:#8ef0e6;height:max-content}
.controls{display:flex;flex-wrap:wrap;gap:8px;padding:12px 16px;border-bottom:1px solid var(--l)}button,input{font:inherit}.btn{padding:10px 13px;border:1px solid var(--l);border-radius:10px;background:var(--p2);color:var(--t)}.primary{background:var(--a);border:0}.controls label{margin-left:auto;color:var(--m);display:flex;align-items:center;gap:8px}
.stage{padding:16px;min-height:430px;display:flex;flex-direction:column}.visual{flex:1;min-height:330px;display:flex;align-items:center;justify-content:center}.bars{height:290px;width:100%;display:flex;align-items:flex-end;gap:5px;padding-top:30px;border-bottom:1px solid var(--l)}.bar{flex:1;min-width:4px;background:linear-gradient(var(--a),#4f3fca);position:relative;border-radius:6px 6px 2px 2px;transition:.2s}.bar::after{content:attr(data-v);position:absolute;bottom:calc(100% + 4px);left:50%;transform:translateX(-50%);font-size:.58rem;color:var(--m)}.bar.active{background:linear-gradient(var(--w),#d88b18);transform:translateY(-5px)}.bar.done{background:linear-gradient(var(--ok),#1b9958)}.bar.pivot{background:linear-gradient(var(--danger),#c93f48)}
.nodes{display:flex;flex-wrap:wrap;gap:11px;justify-content:center}.node{min-width:58px;min-height:58px;display:grid;place-items:center;border:2px solid var(--l);border-radius:14px;background:var(--p2);font-weight:800}.node.active{border-color:var(--w)}.node.done{border-color:var(--ok)}.node.pivot{border-color:var(--danger)}
.grid{display:grid;grid-template-columns:repeat(8,42px);gap:5px}.cell{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--l);border-radius:8px;background:var(--p2)}.cell.active{border-color:var(--w);background:#f4b94222}.cell.done{border-color:var(--ok);background:#34c77b22}.cell.queen{font-size:1.4rem;color:#fff}
.graph{position:relative;width:min(650px,100%);height:310px}.g-node{position:absolute;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--p2);border:2px solid var(--l);font-weight:900;transform:translate(-50%,-50%)}.g-node.active{border-color:var(--w)}.g-node.done{border-color:var(--ok)}.edge{position:absolute;height:2px;background:var(--l);transform-origin:left center}
.status{border-top:1px solid var(--l);padding-top:14px;color:var(--m)}.code{display:grid;grid-template-columns:1fr 1fr;gap:14px;border-top:1px solid var(--l);padding:16px}pre{margin:0;background:#090d16;border:1px solid var(--l);border-radius:12px;padding:14px;white-space:pre-wrap;color:#dce7ff}.steps{margin:0;padding:0;list-style:none;display:grid;gap:7px}.steps li{padding:9px 11px;border:1px solid var(--l);border-radius:10px;color:var(--m)}.steps li.active{color:var(--t);border-color:#7c5cff88;background:#7c5cff18}
.note{margin-top:12px;padding:10px 12px;border:1px solid var(--l);border-radius:10px;color:var(--m);font-size:.82rem}
@media(max-width:900px){.layout{grid-template-columns:1fr}aside{position:static;max-height:none}.list{display:grid;grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.list{grid-template-columns:1fr}.head{flex-direction:column}.controls label{width:100%;margin-left:0}.controls input{flex:1}.code{grid-template-columns:1fr}.bars{height:220px;padding-top:34px;gap:3px}.bar::after{font-size:.52rem}.top .muted{display:none}.grid{grid-template-columns:repeat(8,32px)}.cell{width:32px;height:32px;font-size:.72rem}}

.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px 16px;border-bottom:1px solid var(--l)}
.info-box{padding:12px 14px;border:1px solid var(--l);border-radius:12px;background:var(--p2)}
.info-box small{display:block;color:var(--m);text-transform:uppercase;letter-spacing:.08em;font-size:.68rem;margin-bottom:6px}
.info-box p{margin:0;line-height:1.5}
@media(max-width:600px){.info-grid{grid-template-columns:1fr}}
</style>
</head>
