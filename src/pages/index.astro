<script is:inline>
(()=>{const library=document.querySelector('.library-box');if(!library)return;const sim=document.createElement('div');sim.className='loan-sim';sim.innerHTML='<h4>🎬 Dois atendentes, o mesmo pedido e uma única cópia</h4><p>Os dois clientes pedem o mesmo livro. Cada atendente escolhe um método diferente para organizar ou procurar na mesma estante de 10 livros. Quem encontrar primeiro reserva a única cópia.</p><div class="loan-controls"><label>Pedido<select id="loan-request"><option value="0">Dom Casmurro</option><option value="1">O Cortiço</option><option value="4">Memórias Póstumas de Brás Cubas</option><option value="6">Vidas Secas</option></select></label><label>Atendente A<select id="loan-a"><option value="linear">Busca linear</option><option value="merge">Merge Sort + busca</option><option value="quick">Quick Sort + busca</option><option value="bubble">Bubble Sort + busca</option></select></label><label>Atendente B<select id="loan-b"><option value="binary">Busca binária</option><option value="tim">Tim Sort + busca</option><option value="heap">Heap Sort + busca</option><option value="linear">Busca linear</option></select></label><button id="loan-run" class="btn primary">▶ Iniciar atendimento</button></div><div class="loan-status" aria-live="polite">Pronto para receber o mesmo pedido nos dois balcões.</div><div class="loan-lanes"><div class="loan-lane"><strong>Atendente A <span id="loan-label-a"></span></strong><div id="loan-books-a" class="loan-books"></div><small id="loan-step-a">Aguardando...</small></div><div class="loan-lane"><strong>Atendente B <span id="loan-label-b"></span></strong><div id="loan-books-b" class="loan-books"></div><small id="loan-step-b">Aguardando...</small></div></div>';library.appendChild(sim);const titles=['Dom Casmurro','O Cortiço','A Hora da Estrela','Grande Sertão: Veredas','Memórias Póstumas de Brás Cubas','Capitães da Areia','Vidas Secas','O Alienista','Iracema','O Pequeno Príncipe'];const request=sim.querySelector('#loan-request'),a=sim.querySelector('#loan-a'),b=sim.querySelector('#loan-b'),status=sim.querySelector('.loan-status'),run=sim.querySelector('#loan-run');let timers=[],winner=null,runId=0;const labels={linear:'Busca linear',binary:'Busca binária',merge:'Merge Sort + busca',quick:'Quick Sort + busca',bubble:'Bubble Sort + busca',tim:'Tim Sort + busca',heap:'Heap Sort + busca'};const render=(el,state)=>{el.innerHTML=state.order.map((idx,pos)=>'<span class="loan-card '+(state.active===idx?'checking ':'')+(state.found===idx?'found ':'')+(state.loaned===idx?'loaned ':'')+'" data-pos="'+pos+'">'+(pos+1)+'. '+titles[idx]+'</span>').join('')};const sorted=()=>titles.map((_,i)=>i).sort((x,y)=>titles[x].localeCompare(titles[y]));const makeState=(method,target)=>{const state={method,target,order:method==='binary'?sorted():titles.map((_,i)=>i),active:-1,found:-1,loaned:-1,steps:0,phase:method==='binary'?'search':method==='linear'?'search':'sort',cursor:0,lo:0,hi:9};return state};
const step=state=>{state.steps++;if(state.phase==='sort'){if(state.cursor>=9){state.phase='search';state.cursor=0;state.active=-1;return 'Estante organizada; iniciando a busca.'}let min=state.cursor;for(let j=state.cursor+1;j<10;j++)if(titles[state.order[j]]<titles[state.order[min]])min=j;[state.order[state.cursor],state.order[min]]=[state.order[min],state.order[state.cursor]];state.active=state.order[state.cursor];state.cursor++;return labels[state.method].split(' +')[0]+': colocando o próximo livro na posição '+state.cursor+'.'}if(state.method==='binary'){if(state.lo>state.hi)return 'Livro não encontrado.';const mid=Math.floor((state.lo+state.hi)/2),idx=state.order[mid];state.active=idx;if(idx===state.target){state.found=idx;return 'Busca binária encontrou o livro no meio do intervalo.'}if(titles[idx].localeCompare(titles[state.target])<0)state.lo=mid+1;else state.hi=mid-1;return 'Busca binária: descartando metade da estante.'}if(state.cursor>=state.order.length)return 'Livro não encontrado.';const idx=state.order[state.cursor++];state.active=idx;if(idx===state.target){state.found=idx;return 'Livro encontrado após conferir '+state.steps+' posição(ões).'}return labels[state.method]+': conferindo o livro '+state.steps+'.'};const draw=(state,booksEl,stepEl)=>{render(booksEl,state);stepEl.textContent=state.message};const startLane=(state,booksEl,stepEl,side,id)=>{const tick=()=>{if(id!==runId)return;if(state.found>=0){if(winner===null){winner=side;state.loaned=state.found;status.textContent=side+' encontrou primeiro e reservou a única cópia para seu cliente.'}else if(winner!==side){state.loaned=state.found;status.textContent='Conflito: '+winner+' ganhou a única cópia; '+side+' encontrou o livro, mas ele já está emprestado.'}draw(state,booksEl,stepEl);return}state.message=step(state);draw(state,booksEl,stepEl);if(state.found<0&&state.steps<30)timers.push(setTimeout(tick,360));};tick()};const reset=()=>{timers.forEach(clearTimeout);timers=[];winner=null;runId++;const target=Number(request.value),sa=makeState(a.value,target),sb=makeState(b.value,target);sim.querySelector('#loan-label-a').textContent='· '+labels[a.value];sim.querySelector('#loan-label-b').textContent='· '+labels[b.value];status.textContent='Os dois clientes pediram “'+titles[target]+'”. A única cópia está na estante.';startLane(sa,sim.querySelector('#loan-books-a'),sim.querySelector('#loan-step-a'),'Atendente A',runId);startLane(sb,sim.querySelector('#loan-books-b'),sim.querySelector('#loan-step-b'),'Atendente B',runId)};run.addEventListener('click',reset);a.addEventListener('change',()=>{sim.querySelector('#loan-label-a').textContent='· '+labels[a.value]});b.addEventListener('change',()=>{sim.querySelector('#loan-label-b').textContent='· '+labels[b.value]});sim.querySelector('#loan-label-a').textContent='· '+labels[a.value];sim.querySelector('#loan-label-b').textContent='· '+labels[b.value];reset()})();
