const languageSelect=document.createElement('select');languageSelect.id='language-select';languageSelect.setAttribute('aria-label','Linguagem do codigo');languageSelect.innerHTML='<option value="python">Python</option><option value="cpp">C++</option>';const codeBlock=document.getElementById('code');if(codeBlock){const toolbar=document.createElement('div');toolbar.className='code-toolbar';toolbar.innerHTML='<span>💻 Codigo de implementacao</span>';toolbar.appendChild(languageSelect);codeBlock.parentElement.insertBefore(toolbar,codeBlock)}
const codeExamples={"Bubble Sort":{python:`def bubble_sort(values):\n    for end in range(len(values)-1, 0, -1):\n        for i in range(end):\n            if values[i] > values[i + 1]:\n                values[i], values[i + 1] = values[i + 1], values[i]\n    return values`,cpp:`vector<int> bubbleSort(vector<int> values) {\n    for (int end = values.size() - 1; end > 0; --end) {\n        for (int i = 0; i < end; ++i) {\n            if (values[i] > values[i + 1]) swap(values[i], values[i + 1]);\n        }\n    }\n    return values;\n}`},"Quick Sort":{python:`def quick_sort(values):\n    if len(values) <= 1:\n        return values\n    pivot = values[-1]\n    lower = [x for x in values[:-1] if x < pivot]\n    higher = [x for x in values[:-1] if x >= pivot]\n    return quick_sort(lower) + [pivot] + quick_sort(higher)`,cpp:`vector<int> quickSort(vector<int> values) {\n    if (values.size() <= 1) return values;\n    int pivot = values.back();\n    vector<int> lower, higher;\n    for (int x : values) (x < pivot ? lower : higher).push_back(x);\n    lower = quickSort(lower); higher = quickSort(higher);\n    lower.push_back(pivot); lower.insert(lower.end(), higher.begin(), higher.end());\n    return lower;\n}`},"Busca Binária":{python:`def binary_search(values, target):\n    left, right = 0, len(values) - 1\n    while left <= right:\n        middle = (left + right) // 2\n        if values[middle] == target: return middle\n        if values[middle] < target: left = middle + 1\n        else: right = middle - 1\n    return -1`,cpp:`int binarySearch(const vector<int>& values, int target) {\n    int left = 0, right = values.size() - 1;\n    while (left <= right) {\n        int middle = left + (right - left) / 2;\n        if (values[middle] == target) return middle;\n        if (values[middle] < target) left = middle + 1;\n        else right = middle - 1;\n    }\n    return -1;\n}`}};
function updateLanguageCode(){if(!codeBlock||typeof cur==='undefined')return;const sample=codeExamples[cur.name];const fallback=languageSelect.value==='python'?`def executar(entrada):\n    # ${cur.name}\n    for etapa in entrada:\n        processar(etapa)\n    return entrada`:`vector<int> executar(vector<int> entrada) {\n    // ${cur.name}\n    for (int etapa : entrada) processar(etapa);\n    return entrada;\n}`;codeBlock.textContent=sample?.[languageSelect.value]||fallback}
languageSelect.addEventListener('change',updateLanguageCode);const selectWithLanguage=select;select=function(id){selectWithLanguage(id);updateLanguageCode()};updateLanguageCode();
</script>
<script is:inline>
languageSelect.innerHTML='<option value="python">Python</option><option value="cpp">C++</option><option value="java">Java</option><option value="javascript">JavaScript</option><option value="csharp">C#</option><option value="go">Go</option><option value="rust">Rust</option><option value="portugol">Portugol</option>';
const languageTemplates={java:`public static int[] executar(int[] valores) {\n    for (int fim = valores.length - 1; fim > 0; fim--) {\n        for (int i = 0; i < fim; i++) {\n            if (valores[i] > valores[i + 1]) {\n                int temp = valores[i]; valores[i] = valores[i + 1]; valores[i + 1] = temp;\n            }\n        }\n    }\n    return valores;\n}`,javascript:`function executar(valores) {\n  for (let fim = valores.length - 1; fim > 0; fim--) {\n    for (let i = 0; i < fim; i++) {\n      if (valores[i] > valores[i + 1])\n        [valores[i], valores[i + 1]] = [valores[i + 1], valores[i]];\n    }\n  }\n  return valores;\n}`,csharp:`int[] Executar(int[] valores) {\n    for (int fim = valores.Length - 1; fim > 0; fim--)\n        for (int i = 0; i < fim; i++)\n            if (valores[i] > valores[i + 1])\n                (valores[i], valores[i + 1]) = (valores[i + 1], valores[i]);\n    return valores;\n}`,go:`func executar(valores []int) []int {\n    for fim := len(valores)-1; fim > 0; fim-- {\n        for i := 0; i < fim; i++ {\n            if valores[i] > valores[i+1] {\n                valores[i], valores[i+1] = valores[i+1], valores[i]\n            }\n        }\n    }\n    return valores\n}`,rust:`fn executar(mut valores: Vec<i32>) -> Vec<i32> {\n    for fim in (1..valores.len()).rev() {\n        for i in 0..fim {\n            if valores[i] > valores[i + 1] {\n                valores.swap(i, i + 1);\n            }\n        }\n    }\n    valores\n}`,portugol:`algoritmo "ordenacao_bolha"\nvar\n   valores: vetor[1..10] de inteiro\n   i, fim, temp: inteiro\ninicio\n   para fim de 10 ate 2 passo -1 faca\n      para i de 1 ate fim - 1 faca\n         se valores[i] > valores[i + 1] entao\n            temp <- valores[i]\n            valores[i] <- valores[i + 1]\n            valores[i + 1] <- temp\n         fimse\n      fimpara\n   fimpara\nfimalgoritmo`};
const previousLanguageUpdate=updateLanguageCode;updateLanguageCode=function(){if(cur.name==='Bubble Sort'&&languageTemplates[languageSelect.value]){codeBlock.textContent=languageTemplates[languageSelect.value];return}previousLanguageUpdate()};languageSelect.onchange=updateLanguageCode;const previousLanguageSelect=select;select=function(id){previousLanguageSelect(id);updateLanguageCode()};updateLanguageCode();
</script>
