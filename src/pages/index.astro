<script is:inline>
(()=>{const host=document.querySelector('.snack-sim')||document.querySelector('.complexity-guide');if(!host||document.querySelector('.shelf-route'))return;const panel=document.createElement('div');panel.className='shelf-route';panel.innerHTML='<h4>🗄️ Prateleira com 170 posições — 17 colunas × 10 alturas</h4><p>Cada quadrado representa um espaço da prateleira. Escolha o pedido e veja duas rotas até a mesma posição: Atendente A entra pela esquerda e Atendente B pela direita.</p><div class="shelf-head"><span id="shelf-request">Pedido: Hambúrguer artesanal</span><button id="shelf-run" class="btn primary">▶ Simular rota</button></div><div class="shelf-legend"><span class="legend-a">● Rota A</span><span class="legend-b">● Rota B</span><span class="legend-target">◆ Pedido</span></div><div class="shelf-scroll"><div id="shelf-grid" class="shelf-grid"></div></div><div id="shelf-status" class="shelf-status">Aguardando os atendentes.</div>';host.appendChild(panel);const grid=panel.querySelector('#shelf-grid'),status=panel.querySelector('#shelf-status'),run=panel.querySelector('#shelf-run'),request=document.querySelector('#snack-request');const foods=['Hambúrguer artesanal','Pizza Margherita','Batata frita','Sushi vegano','Taco mexicano','Coxinha','Salada tropical','Curry indiano','Bife grelhado','Donut'];const starts=[{r:9,c:0},{r:9,c:16}],targets=[{r:1,c:4},{r:7,c:13},{r:2,c:9},{r:8,c:2},{r:0,c:15},{r:5,c:6},{r:3,c:11},{r:9,c:8},{r:1,c:14},{r:6,c:1}];let timers=[],runId=0;const cell=(r,c)=>grid.querySelector('[data-cell="'+(r*17+c)+'"]');for(let r=0;r<10;r++)for(let c=0;c<17;c++){const node=document.createElement('span');node.dataset.cell=r*17+c;node.title='Posição '+(r*17+c+1)+' · coluna '+(c+1)+' · altura '+(10-r);node.textContent=r===0?'□':'';grid.appendChild(node)}const route=(start,target,horizontalFirst)=>{const out=[{...start}],p={...start};if(horizontalFirst){while(p.c!==target.c){p.c+=p.c<target.c?1:-1;out.push({...p})}while(p.r!==target.r){p.r+=p.r<target.r?1:-1;out.push({...p})}}else{while(p.r!==target.r){p.r+=p.r<target.r?1:-1;out.push({...p})}while(p.c!==target.c){p.c+=p.c<target.c?1:-1;out.push({...p})}}return out};const drawTarget=()=>{grid.querySelectorAll('span').forEach(x=>{x.className='';x.textContent=''});const idx=Number(request?.value||0),t=targets[idx];cell(t.r,t.c).className='target';cell(t.r,t.c).textContent='◆';panel.querySelector('#shelf-request').textContent='Pedido: '+foods[idx]+' · posição '+(t.r*17+t.c+1)+'/170'};const animate=(path,cls,who,id)=>path.forEach((p,i)=>timers.push(setTimeout(()=>{if(id!==runId)return;const node=cell(p.r,p.c);if(!node.classList.contains('target'))node.classList.add(cls);status.textContent=who+' percorreu '+(i+1)+' de '+path.length+' posições.';if(i===path.length-1)node.textContent='✓'},i*90)));const start=()=>{timers.forEach(clearTimeout);timers=[];runId++;const id=runId,idx=Number(request?.value||0),target=targets[idx],a=route(starts[0],target,true),b=route(starts[1],target,false);drawTarget();status.textContent='Duas rotas começaram para o mesmo pedido.';animate(a,'route-a','Atendente A',id);animate(b,'route-b','Atendente B',id);timers.push(setTimeout(()=>{if(id===runId)status.textContent='Os dois atendentes chegaram à posição '+(target.r*17+target.c+1)+' da prateleira.'},Math.max(a.length,b.length)*90+120))};request?.addEventListener('change',drawTarget);run.addEventListener('click',start);drawTarget();start()})();
</script>
