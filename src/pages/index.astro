<script is:inline>
const detailPresets={
"Bubble Sort":["Compara vizinhos e troca os que estao fora de ordem.","Aprendizado, listas pequenas e dados quase ordenados.","Evite em listas grandes: faz muitas comparacoes.","O(n) melhor caso; O(n²) medio e pior caso.","O(1) de memoria extra.","O nome vem das maiores chaves 'borbulhando' para o fim."],
"Selection Sort":["Procura o menor item restante e coloca-o na proxima posicao.","Listas pequenas quando o numero de trocas precisa ser baixo.","Evite em grandes volumes de dados.","O(n²) em todos os casos.","O(1) de memoria extra.","Pode ser util quando escrever na memoria e mais caro que comparar."],
"Insertion Sort":["Insere cada item no lugar correto dentro da parte ja ordenada.","Listas pequenas ou que chegam quase ordenadas.","Evite quando os dados estao muito desorganizados e sao numerosos.","O(n) melhor caso; O(n²) medio e pior caso.","O(1) de memoria extra.","E parecido com organizar cartas na mao."],
"Merge Sort":["Divide a lista em partes, ordena cada uma e intercala os resultados.","Grandes volumes, ordenacao estavel e processamento externo.","Evite quando a memoria extra precisa ser minima.","O(n log n) em todos os casos.","O(n) de memoria extra.","A estrategia de dividir e conquistar aparece em muitos algoritmos."],
"Quick Sort":["Escolhe um pivo e separa valores menores e maiores ao redor dele.","Ordenacao geral em memoria e bibliotecas de alto desempenho.","Evite pivos ruins repetidos ou quando estabilidade e obrigatoria.","O(n log n) medio; O(n²) pior caso.","O(log n) medio de pilha; O(n) pior caso.","A escolha do pivo muda bastante o comportamento pratico."],
"Busca Linear":["Verifica os itens um por um ate encontrar o alvo.","Listas pequenas ou que nao estao ordenadas.","Evite quando a lista e grande e pode ser ordenada previamente.","O(1) melhor caso; O(n) medio e pior caso.","O(1) de memoria extra.","E a busca mais simples e funciona em praticamente qualquer sequencia."],
"Busca Binária":["Compara o meio e descarta metade da lista a cada passo.","Listas ordenadas, catalogos e indices.","Evite se os dados nao estiverem ordenados.","O(1) melhor caso; O(log n) medio e pior caso.","O(1) iterativa.","Cada comparacao elimina aproximadamente metade das possibilidades."],
"BFS":["Explora um grafo por camadas, visitando primeiro os vizinhos mais proximos.","Menor numero de passos, redes sociais e labirintos sem pesos.","Evite quando as arestas possuem pesos diferentes.","O(V + E).", "O(V) para fila e visitados.","BFS encontra caminhos minimos quando todas as arestas custam igual."],
"DFS":["Segue um caminho ate o fim e volta quando nao ha mais vizinhos.","Ciclos, componentes, pastas e exploracao de grafos.","Evite quando precisa do caminho mais curto sem pesos.","O(V + E).", "O(V) para pilha e visitados.","Pode ser implementada com recursao ou com uma pilha explicita."],
"Dijkstra":["Escolhe sempre o vertice nao visitado com menor distancia conhecida.","GPS, mapas e redes com pesos nao negativos.","Evite pesos negativos; use Bellman-Ford nesses casos.","O((V + E) log V) com fila de prioridade.","O(V + E).", "O algoritmo foi publicado por Edsger Dijkstra em 1959."]
};
const oldFillDetails=fillDetails;fillDetails=function(){oldFillDetails();const d=detailPresets[cur.name];if(!d)return;['detail-how','detail-use','detail-avoid','detail-time','detail-space','detail-curiosity'].forEach((id,i)=>{const el=document.getElementById(id);if(el)el.textContent=d[i]})};fillDetails();
</script>
