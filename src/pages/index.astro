<script is:inline>
(()=>{
const sim=document.querySelector('.snack-sim');
if(!sim)return;
sim.querySelector('.sticker-legend')?.remove();
sim.querySelector('.menu-board')?.remove();
sim.querySelector('.snack-lanes')?.remove();
sim.querySelector('.compact-route')?.remove();
sim.querySelector('.stock-route')?.remove();
sim.querySelector('.shelf-route')?.remove();
const names=['Hambúrguer artesanal','Pizza Margherita','Batata frita','Sushi vegano','Taco mexicano','Coxinha','Salada tropical','Curry indiano','Bife grelhado','Donut'];
const foods=[
{price:100,diet:'porcaria',type:'artesanal',prep:'bem assado',service:'mesa'},
{price:10,diet:'vegetariana',type:'estrangeira',prep:'bem assado',service:'viagem'},
{price:1,diet:'porcaria',type:'fast food',prep:'bem assado',service:'viagem'},
{price:100,diet:'vegana',type:'estrangeira',prep:'bem assado',service:'viagem'},
{price:10,diet:'porcaria',type:'estrangeira',prep:'bem assado',service:'viagem'},
{price:1,diet:'porcaria',type:'fast food',prep:'bem assado',service:'viagem'},
{price:10,diet:'vegana',type:'artesanal',prep:'bem assado',service:'mesa'},
{price:100,diet:'vegana',type:'estrangeira',prep:'bem assado',service:'mesa'},
{price:100,diet:'porcaria',type:'artesanal',prep:'mal passado',service:'mesa'},
{price:1,diet:'vegetariana',type:'fast food',prep:'bem assado',service:'viagem'}
];
const fields={price:['R$ 1','R$ 10','R$ 100'],diet:['vegana','vegetariana','porcaria'],type:['fast food','estrangeira','artesanal'],prep:['mal passado','médio','bem assado'],service:['mesa','viagem']};
const labels={price:'Valor',diet:'Calorias / alimentação',type:'Tipo',prep:'Preparo',service:'Entrega'};
const methods={linear:'Busca linear',binary:'Busca binária',quick:'Quick Sort',merge:'Merge Sort',bubble:'Bubble Sort',tim:'Tim Sort',heap:'Heap Sort'};
const sorted=(method,field)=>{
const order=names.map((_,i)=>i);
if(method==='linear')return order;
return order.sort((a,b)=>String(foods[a][field]).localeCompare(String(foods[b][field]),'pt-BR',{numeric:true}));
};
const menu=document.createElement('section');
menu.className='menu-board menu-options';
menu.innerHTML='<div class="menu-title">CARDÁPIO — 14 opções classificáveis por comida</div><p class="menu-help">Cada linha mostra as 14 possibilidades: 3 valores + 3 alimentações + 3 tipos + 3 preparos + 2 formas de serviço. A opção real de cada comida fica marcada.</p><div class="menu-list"></div>';
const list=menu.querySelector('.menu-list');
names.forEach((name,i)=>{
const d=foods[i];
const row=document.createElement('article');
row.className='menu-food';
row.innerHTML='<strong>'+name+'</strong><div class="menu-option-groups"></div>';
const groups=row.querySelector('.menu-option-groups');
Object.keys(fields).forEach(field=>{
const group=document.createElement('div');
group.className='menu-option-group';
group.innerHTML='<b>'+labels[field]+'</b>';
fields[field].forEach(value=>{
const option=document.createElement('span');
option.className=String(d[field])===value||String(d[field])==='mesa'&&value==='mesa'?'selected-option':'';
option.textContent=value;
group.appendChild(option);
});
groups.appendChild(group);
});
list.appendChild(row);
});
sim.insertBefore(menu,sim.querySelector('.snack-controls'));
const scene=document.createElement('section');
scene.className='sort-route-scene';
scene.innerHTML='<div class="scene-title">Rota definida pelo algoritmo</div><div class="scene-subtitle">Os dois atendentes saem do mesmo balcão, vão para estoques diferentes, pegam a mesma comida e retornam.</div><div class="route-stage"><div class="route-rack rack-a"><b>PRATELEIRA A</b><small id="rack-a-position"></small><div id="rack-a-slots" class="rack-slots"></div></div><div class="route-counter"><span class="counter-person">🧑‍🍳</span><b>BALCÃO</b><small id="route-pickup">pedido aguardando</small></div><div class="route-rack rack-b"><b>PRATELEIRA B</b><small id="rack-b-position"></small><div id="rack-b-slots" class="rack-slots"></div></div><div class="route-path path-a"><i id="route-runner-a">🏃‍♂️</i></div><div class="route-path path-b"><i id="route-runner-b">🏃‍♀️</i></div></div><div class="route-readout"><div><b id="route-label-a">Atendente A</b><span id="route-message-a">Aguardando.</span></div><div><b id="route-label-b">Atendente B</b><span id="route-message-b">Aguardando.</span></div></div><div id="sort-route-status" class="sort-route-status">Aguardando o pedido.</div>';
sim.appendChild(scene);
const request=sim.querySelector('#snack-request');
const field=sim.querySelector('#snack-field');
const methodA=sim.querySelector('#snack-a');
const methodB=sim.querySelector('#snack-b');
const runButton=sim.querySelector('#snack-run');
const status=scene.querySelector('#sort-route-status');
let timer=null;
const drawRack=(id,order,target)=>{
const rack=scene.querySelector(id);rack.innerHTML='';
order.forEach((foodIndex,position)=>{
const slot=document.createElement('span');
slot.className=foodIndex===target?'active-slot':'';
slot.textContent=(position+1)+'. '+names[foodIndex];
rack.appendChild(slot);
});
};
const play=()=>{
clearInterval(timer);
const target=Number(request.value);
const selectedField=field.value;
const orderA=sorted(methodA.value,selectedField);
const orderB=sorted(methodB.value,selectedField);
const posA=orderA.indexOf(target)+1;
const posB=orderB.indexOf(target)+1;
drawRack('#rack-a-slots',orderA,target);drawRack('#rack-b-slots',orderB,target);
scene.querySelector('#rack-a-position').textContent='posição '+posA+'/10 · '+methods[methodA.value];
scene.querySelector('#rack-b-position').textContent='posição '+posB+'/10 · '+methods[methodB.value];
scene.querySelector('#route-label-a').textContent='A · '+methods[methodA.value];
scene.querySelector('#route-label-b').textContent='B · '+methods[methodB.value];
scene.querySelector('#route-runner-a').style.left='100%';scene.querySelector('#route-runner-b').style.left='0%';
scene.querySelector('#route-message-a').textContent='Saindo do balcão.';scene.querySelector('#route-message-b').textContent='Saindo do balcão.';
scene.querySelector('#route-pickup').textContent=names[target]+' aguardando';
status.textContent='Sort definido: '+names[target]+' está na posição '+posA+' para A e '+posB+' para B.';
let step=0;
timer=setInterval(()=>{
step++;
const go=step<=10;
const progress=go?step*10:Math.max(0,100-(step-10)*10);
scene.querySelector('#route-runner-a').style.left=(100-progress)+'%';
scene.querySelector('#route-runner-b').style.left=progress+'%';
if(step<10){scene.querySelector('#route-message-a').textContent='Indo para a prateleira A: '+step+'/10';scene.querySelector('#route-message-b').textContent='Indo para a prateleira B: '+step+'/10';status.textContent='As rotas estão sendo percorridas conforme a ordem do sort.';}
else if(step===10){scene.querySelector('#route-message-a').textContent='Pegou '+names[target]+' na posição '+posA+'.';scene.querySelector('#route-message-b').textContent='Pegou '+names[target]+' na posição '+posB+'.';scene.querySelector('#route-pickup').textContent=names[target]+' em transporte';status.textContent='Os dois atendentes encontraram a comida nas suas prateleiras.';}
else if(step<20){const back=step-10;scene.querySelector('#route-message-a').textContent='Voltando ao balcão: '+back+'/10';scene.querySelector('#route-message-b').textContent='Voltando ao balcão: '+back+'/10';status.textContent='Retorno ao mesmo balcão com o pedido.';}
else{scene.querySelector('#route-message-a').textContent='Entregue no balcão.';scene.querySelector('#route-message-b').textContent='Entregue no balcão.';scene.querySelector('#route-pickup').textContent=names[target]+' entregue';status.textContent='Comparação concluída: duas rotas, um mesmo pedido.';clearInterval(timer);}
},180);
};
runButton.addEventListener('click',play);request.addEventListener('change',play);field.addEventListener('change',play);methodA.addEventListener('change',play);methodB.addEventListener('change',play);play();
})();
</script>
