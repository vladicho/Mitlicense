const setToken=(token,slot)=>{const c=coord(slot);token.style.left=((c.col-.5)/14*100)+'%';token.style.top=((c.row-.5)/10*100)+'%'};
const cellAt=(grid,slot)=>grid.querySelector('[data-slot="'+slot+'"]');
const makeGrid=(id,order)=>{const grid=scene.querySelector(id);grid.innerHTML='';for(let slot=0;slot<140;slot++){const cell=document.createElement('span');cell.className='batch-cell';cell.dataset.slot=slot;cell.setAttribute('aria-label','posição vazia');grid.appendChild(cell)}order.forEach((food,rank)=>{const token=document.createElement('i');token.className='sort-food-token';token.dataset.food=food;token.textContent=icons[food];token.setAttribute('aria-label',names[food]);grid.appendChild(token);setToken(token,sourceSlots[rank])})};
const moveToken=(grid,food,slot)=>{const token=grid.querySelector('[data-food="'+food+'"]');if(token)setToken(token,slot)};
const clearCells=()=>scene.querySelectorAll('.batch-cell').forEach(x=>x.classList.remove('sort-target','sort-ready'));
const renderSort=(grid,order)=>order.forEach((food,rank)=>moveToken(grid,food,sourceSlots[rank]));
const setup=()=>{const a=orderFor(methodA.value,field.value),b=orderFor(methodB.value,field.value);makeGrid('#batch-grid-a',initial);makeGrid('#batch-grid-b',initial);scene.querySelector('#batch-title-a').textContent='PRATELEIRA A · '+methods[methodA.value];scene.querySelector('#batch-title-b').textContent='PRATELEIRA B · '+methods[methodB.value];scene.querySelector('#batch-info-a').textContent='Mesmo início · esperando o sort';scene.querySelector('#batch-info-b').textContent='Mesmo início · esperando o sort';scene.querySelector('#batch-label-a').textContent='A · '+methods[methodA.value];scene.querySelector('#batch-label-b').textContent='B · '+methods[methodB.value];scene.querySelector('#batch-adv-a').textContent='Passos de organização: '+stepsFor(methodA.value,field.value).length;scene.querySelector('#batch-adv-b').textContent='Passos de organização: '+stepsFor(methodB.value,field.value).length;return [a,b]};
const startLane=(side,method,fieldName)=>{const key=side==='a'?'#batch-grid-a':'#batch-grid-b',grid=scene.querySelector(key),steps=stepsFor(method,fieldName),targetOrder=orderFor(method,fieldName),label=side==='a'?'A':'B',title=side==='a'?'#batch-message-a':'#batch-message-b';let step=0,cluster=0,delivery=0,phase='sort';const timer=setInterval(()=>{if(phase==='sort'){if(step<steps.length){renderSort(grid,steps[step]);scene.querySelector('#batch-status').textContent=label+' está executando '+methods[method]+': passo '+(step+1)+'/'+steps.length;scene.querySelector(title).textContent='Ordenando '+names[steps[step][0]]+'...';step++}else{phase='cluster';scene.querySelector(title).textContent='Sort concluído; aproximando do balcão.'}}
else if(phase==='cluster'){if(cluster<10){const food=targetOrder[cluster];moveToken(grid,food,targetSlots[cluster]);const cell=cellAt(grid,targetSlots[cluster]);if(cell)cell.classList.add('sort-target');const c=coord(targetSlots[cluster]);scene.querySelector(title).textContent='Levando '+names[food]+' para linha '+c.row+', coluna '+c.col;scene.querySelector('#batch-status').textContent=label+' agrupando comida '+(cluster+1)+'/10 ao lado do balcão.';cluster++}else{phase='deliver';scene.querySelector(title).textContent='As 10 comidas estão juntas no balcão.'}}
else{if(delivery<10){scene.querySelector('#batch-carry').textContent=icons.slice(0,delivery+1).join('');delivery++;scene.querySelector('#batch-counter-state').textContent='Recebendo '+delivery+'/10 comidas';}else{clearInterval(timer);scene.querySelector('#batch-counter-state').textContent='10 comidas recebidas';scene.querySelector(title).textContent='Pedido completo no balcão.'}}},260);timers.push(timer)};
const play=()=>{timers.forEach(clearInterval);timers=[];clearCells();scene.querySelector('#batch-carry').textContent='';scene.querySelector('#batch-counter-state').textContent='aguardando as 10 comidas';const orders=setup();startLane('a',methodA.value,field.value);startLane('b',methodB.value,field.value);scene.querySelector('#batch-status').textContent='As duas prateleiras começaram com a mesma ordem.';return orders};
run.addEventListener('click',play);field.addEventListener('change',play);methodA.addEventListener('change',play);methodB.addEventListener('change',play);play();
})();
</script>
<style is:global>
.sort-cluster-scene .same-order{margin:6px 0;padding:6px;border-radius:6px;background:#0b111b;color:#f4d58c;font-size:.6rem}.sort-cluster-scene .batch-stage{height:300px}.sort-cluster-scene .batch-shelf{width:37%;height:246px}.sort-cluster-scene .batch-grid{height:208px;position:relative}.sort-cluster-scene .batch-grid-runner{display:none}.sort-cluster-scene .sort-food-token{position:absolute;z-index:5;font-size:1rem;line-height:1;transform:translate(-50%,-50%);transition:left .26s ease,top .26s ease}.sort-cluster-scene .batch-cell.sort-target{background:#f4b942;box-shadow:0 0 8px 2px #ffe39a}.sort-cluster-scene .batch-cell.sort-ready{background:#34c77b}.sort-cluster-scene .batch-readout em{display:block;margin-top:4px;color:#bba984;font-size:.58rem;font-style:normal}.sort-cluster-scene .batch-counter{position:relative}.sort-cluster-scene .batch-counter #batch-carry{display:block;min-height:18px;margin-top:3px;color:#fff0a8;font-size:.7rem;letter-spacing:-2px}@media(max-width:600px){.sort-cluster-scene .batch-stage{height:330px}.sort-cluster-scene .batch-shelf{width:43%;height:255px}.sort-cluster-scene .batch-grid{height:218px}.sort-cluster-scene .batch-counter{left:35%;right:35%;bottom:24px}}
</style>
<script is:inline>
(()=>{const sim=document.querySelector('.sort-cluster-scene');if(!sim)return;const run=sim.querySelector('#snack-run')||document.querySelector('#snack-run'),status=sim.querySelector('#batch-status'),state=sim.querySelector('#batch-counter-state');let poll=null;const watch=()=>{clearInterval(poll);poll=setInterval(()=>{const messages=[sim.querySelector('#batch-message-a')?.textContent||'',sim.querySelector('#batch-message-b')?.textContent||''];if(messages.every(x=>x.includes('Pedido completo')||x.includes('Lote entregue'))||state?.textContent==='10 comidas recebidas'){status.textContent='Concluído: as duas lanchonetes entregaram o mesmo pedido.';clearInterval(poll)}},200)};run?.addEventListener('click',watch);sim.querySelector('#snack-field')?.addEventListener('change',watch);sim.querySelector('#snack-a')?.addEventListener('change',watch);sim.querySelector('#snack-b')?.addEventListener('change',watch);watch()})();
</script>
<style is:global>
.sort-cluster-scene .order-builder{margin:8px 0 10px;padding:8px;border:1px solid #9af5eb55;border-radius:8px;background:#0b111b}.sort-cluster-scene .builder-title{color:#f4d58c;font-size:.75rem;font-weight:700}.sort-cluster-scene .builder-help{margin:3px 0 7px;color:var(--m);font-size:.62rem}.sort-cluster-scene .menu-picks{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;margin-bottom:8px}.sort-cluster-scene .menu-pick{display:flex;align-items:center;gap:3px;padding:4px;border-radius:4px;background:#172338;color:#d8e2f5;font-size:.58rem}.sort-cluster-scene .menu-pick input{accent-color:#2dd4bf}.sort-cluster-scene .coord-table{width:100%;border-collapse:collapse;font-size:.58rem}.sort-cluster-scene .coord-table th,.sort-cluster-scene .coord-table td{padding:3px;text-align:left;border-bottom:1px solid #ffffff18}.sort-cluster-scene .coord-table th{color:#bba984;font-weight:500}.sort-cluster-scene .coord-food{color:#fff3c9}.sort-cluster-scene .coord-input{width:62px;padding:3px;border:1px solid #ffffff2b;border-radius:4px;background:#172338;color:#eef5ff;font:inherit}.sort-cluster-scene .coord-input:focus{outline:2px solid #9af5eb}.sort-cluster-scene .algorithm-picks{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:8px 0}.sort-cluster-scene .algorithm-picks label{display:grid;gap:3px;color:#bba984;font-size:.58rem}.sort-cluster-scene .algorithm-picks select{padding:5px;border:1px solid #ffffff2b;border-radius:5px;background:#172338;color:#eef5ff;font:inherit}.sort-cluster-scene .builder-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.sort-cluster-scene .builder-validation{color:#f4b942;font-size:.6rem}.sort-cluster-scene .custom-order-grid .batch-cell{transition:background .16s,box-shadow .16s}.sort-cluster-scene .custom-order-grid .batch-cell.has-food{background:#233c46}.sort-cluster-scene .custom-order-grid .batch-cell.target-slot{outline:1px solid #f4b942}.sort-cluster-scene .custom-food-token{position:absolute;z-index:5;font-size:1rem;line-height:1;transform:translate(-50%,-50%);transition:left .3s ease,top .3s ease}.sort-cluster-scene .coordinate-readout{margin-top:6px;color:#bba984;font-size:.59rem}.sort-cluster-scene .coordinate-readout b{color:#9af5eb;font-weight:500}@media(max-width:700px){.sort-cluster-scene .menu-picks{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.sort-cluster-scene .algorithm-picks{grid-template-columns:1fr}.sort-cluster-scene .coord-input{width:52px}}
</style>
<script is:inline>
(()=>{
const old=document.querySelector('.sort-cluster-scene');if(!old)return;const root=old.parentElement;
const names=['Hamburguer artesanal','Pizza Margherita','Batata frita','Sushi vegano','Taco mexicano','Coxinha','Salada tropical','Curry indiano','Bife grelhado','Donut'];
const icons=['🍔','🍕','🍟','🍣','🌮','🥟','🥗','🍛','🥩','🍩'];
const methods={bubble:'Bubble Sort',selection:'Selection Sort',insertion:'Insertion Sort',quick:'Quick Sort',merge:'Merge Sort',heap:'Heap Sort',tim:'Tim Sort'};
const methodOptions=Object.entries(methods).map(([id,label])=>`<option value="${id}">${label}</option>`).join('');const defaultSlots=[4,19,30,47,60,75,88,101,124,137];
const coordFromSlot=slot=>({row:Math.floor(slot/14)+1,col:slot%14+1});const slotFromCoord=(row,col)=>((row-1)*14)+(col-1);const coordText=slot=>{const c=coordFromSlot(slot);return `L${c.row} C${c.col}`};old.remove();
const scene=document.createElement('section');scene.className='batch-route-scene sort-cluster-scene';scene.innerHTML=`<div class="scene-title">Monte o mesmo pedido para as duas lanchonetes</div><div class="scene-subtitle">Escolha exatamente 10 comidas, defina onde cada uma começa em cada prateleira e compare dois algoritmos organizando o pedido perto do balcão.</div><div class="order-builder"><div class="builder-title">1. Cardápio do pedido</div><div class="builder-help">Marque as comidas que o cliente pediu. Neste exemplo, o pedido precisa ter 10 itens.</div><div class="menu-picks">${names.map((name,i)=>`<label class="menu-pick"><input class="food-choice" type="checkbox" value="${i}" checked><span>${icons[i]} ${name}</span></label>`).join('')}</div><div class="builder-title">2. Coordenadas iniciais nas prateleiras</div><div class="builder-help">Use linha 1–10 e coluna 1–14. A e B podem começar em posições diferentes.</div><table class="coord-table"><thead><tr><th>Comida</th><th>Prateleira A<br><small>linha,coluna</small></th><th>Prateleira B<br><small>linha,coluna</small></th></tr></thead><tbody>${names.map((name,i)=>{const a=coordFromSlot(defaultSlots[i]),b=coordFromSlot(defaultSlots[9-i]);return `<tr><td class="coord-food">${icons[i]} ${name}</td><td><input class="coord-input coord-a" data-food="${i}" value="${a.row},${a.col}" aria-label="Coordenada A de ${name}"></td><td><input class="coord-input coord-b" data-food="${i}" value="${b.row},${b.col}" aria-label="Coordenada B de ${name}"></td></tr>`}).join('')}</tbody></table><div class="algorithm-picks"><label>Lanchonete A · algoritmo<select id="custom-method-a">${methodOptions}</select></label><label>Lanchonete B · algoritmo<select id="custom-method-b">${methodOptions}</select></label></div><div class="builder-actions"><button type="button" class="btn primary" id="custom-order-run">Montar pedido e executar</button><span id="custom-validation" class="builder-validation">10 comidas selecionadas.</span></div></div><div class="same-order" id="custom-order-line">Pedido atual: 10 comidas selecionadas.</div><div class="batch-stage no-corridor"><div class="batch-shelf shelf-left"><b id="custom-title-a">PRATELEIRA A</b><small id="custom-info-a"></small><div id="custom-grid-a" class="batch-grid custom-order-grid"></div></div><div class="batch-counter"><span>🧑‍🍳</span><b>BALCÃO</b><small id="custom-counter-state">Faça o pedido para começar</small><span id="custom-carry"></span></div><div class="batch-shelf shelf-right"><b id="custom-title-b">PRATELEIRA B</b><small id="custom-info-b"></small><div id="custom-grid-b" class="batch-grid custom-order-grid"></div></div></div><div class="batch-readout"><div><b id="custom-label-a">Lanchonete A</b><span id="custom-message-a">Aguardando o pedido.</span><em id="custom-adv-a"></em></div><div><b id="custom-label-b">Lanchonete B</b><span id="custom-message-b">Aguardando o pedido.</span><em id="custom-adv-b"></em></div></div><div class="coordinate-readout" id="custom-coordinate-readout">As coordenadas aparecerão aqui durante a coleta.</div><div id="custom-status" class="batch-status">Configure o cardápio e as posições.</div>`;root.appendChild(scene);
const gridA=scene.querySelector('#custom-grid-a'),gridB=scene.querySelector('#custom-grid-b');const selected=()=>[...scene.querySelectorAll('.food-choice:checked')].map(x=>Number(x.value));const readCoord=input=>{const m=input.value.trim().match(/^(\d{1,2})\s*[,; ]\s*(\d{1,2})$/);if(!m)return null;const r=Number(m[1]),c=Number(m[2]);return r>=1&&r<=10&&c>=1&&c<=14?slotFromCoord(r,c):null};const positionsFor=side=>{const out={};for(const f of selected()){const input=scene.querySelector(`.coord-${side}[data-food="${f}"]`);out[f]=readCoord(input)}return out};
const placeToken=(token,slot)=>{const c=coordFromSlot(slot);token.style.left=((c.col-.5)/14*100)+'%';token.style.top=((c.row-.5)/10*100)+'%'};const makeGrid=(grid,positions)=>{grid.innerHTML='';for(let slot=0;slot<140;slot++){const cell=document.createElement('span');cell.className='batch-cell';cell.dataset.slot=slot;grid.appendChild(cell)}for(const f of selected()){const slot=positions[f];if(slot===null)continue;const cell=grid.querySelector(`[data-slot="${slot}"]`);if(cell)cell.classList.add('has-food');const token=document.createElement('i');token.className='custom-food-token';token.dataset.food=f;token.textContent=icons[f];token.setAttribute('aria-label',names[f]);grid.appendChild(token);placeToken(token,slot)}};
const algorithmSteps=(method,items,positions)=>{let cur=items.slice(),steps=[cur.slice()],before=(a,b)=>positions[a]>positions[b];if(method==='bubble'){for(let e=cur.length-1;e>0;e--)for(let j=0;j<e;j++)if(before(cur[j],cur[j+1])){[cur[j],cur[j+1]]=[cur[j+1],cur[j]];steps.push(cur.slice())}}else if(method==='insertion'){for(let i=1;i<cur.length;i++){let j=i;while(j>0&&before(cur[j-1],cur[j])){[cur[j-1],cur[j]]=[cur[j],cur[j-1]];steps.push(cur.slice());j--}}}else{for(let i=0;i<cur.length-1;i++){let best=i;for(let j=i+1;j<cur.length;j++)if(positions[cur[j]]<positions[cur[best]])best=j;if(best!==i){[cur[i],cur[best]]=[cur[best],cur[i]];steps.push(cur.slice())}}}return{steps,sorted:cur}};
const updateMenu=()=>{const foods=selected();scene.querySelector('#custom-validation').textContent=foods.length===10?'10 comidas selecionadas.':`Selecione exatamente 10 comidas (agora: ${foods.length}).`;scene.querySelector('#custom-order-line').textContent=foods.length?`Pedido atual: ${foods.map(i=>names[i]).join(' → ')}.`:'Pedido vazio.'};const resetPreview=()=>{makeGrid(gridA,positionsFor('a'));makeGrid(gridB,positionsFor('b'));scene.querySelector('#custom-info-a').textContent='140 quadrados · coordenadas editáveis';scene.querySelector('#custom-info-b').textContent='140 quadrados · coordenadas editáveis'};let timers=[];
const run=()=>{timers.forEach(clearInterval);timers=[];const foods=selected(),pa=positionsFor('a'),pb=positionsFor('b');updateMenu();if(foods.length!==10||foods.some(f=>pa[f]===null||pb[f]===null)){scene.querySelector('#custom-status').textContent='Corrija o pedido: são necessárias 10 comidas e coordenadas válidas nas duas prateleiras.';resetPreview();return}resetPreview();const ma=scene.querySelector('#custom-method-a').value,mb=scene.querySelector('#custom-method-b').value,a=algorithmSteps(ma,foods,pa),b=algorithmSteps(mb,foods,pb);scene.querySelector('#custom-title-a').textContent='PRATELEIRA A · '+methods[ma];scene.querySelector('#custom-title-b').textContent='PRATELEIRA B · '+methods[mb];scene.querySelector('#custom-label-a').textContent='A · '+methods[ma];scene.querySelector('#custom-label-b').textContent='B · '+methods[mb];scene.querySelector('#custom-adv-a').textContent='Passos de organização: '+a.steps.length;scene.querySelector('#custom-adv-b').textContent='Passos de organização: '+b.steps.length;scene.querySelector('#custom-counter-state').textContent='Pedido recebido: 0/10';let lanes=[{x:a,grid:gridA,side:'a',phase:0},{x:b,grid:gridB,side:'b',phase:0}];const tick=setInterval(()=>{let finished=0;for(const lane of lanes){if(lane.phase<lane.x.steps.length){const order=lane.x.steps[lane.phase];order.forEach(f=>{const t=lane.grid.querySelector(`[data-food="${f}"]`);if(t)placeToken(t,lane.side==='a'?pa[f]:pb[f])});scene.querySelector(`#custom-message-${lane.side}`).textContent=`${methods[lane.side==='a'?ma:mb]} · passo ${lane.phase+1}/${lane.x.steps.length}`;lane.phase++}else finished++}if(finished===2){clearInterval(tick);let move=0;const cluster=setInterval(()=>{if(move>=10){clearInterval(cluster);scene.querySelector('#custom-status').textContent='Concluído: as duas lanchonetes organizaram e entregaram o mesmo pedido.';scene.querySelector('#custom-message-a').textContent='Pedido completo no balcão.';scene.querySelector('#custom-message-b').textContent='Pedido completo no balcão.';return}for(const lane of lanes){const f=lane.x.sorted[move],slot=126+move,t=lane.grid.querySelector(`[data-food="${f}"]`);if(t)placeToken(t,slot);const cell=lane.grid.querySelector(`[data-slot="${slot}"]`);if(cell)cell.classList.add('target-slot')}scene.querySelector('#custom-coordinate-readout').innerHTML=`Comida ${move+1}/10: <b>${names[a.sorted[move]]}</b> agrupada na posição ${coordText(126+move)}.`;scene.querySelector('#custom-counter-state').textContent=`Organizando o pedido: ${move+1}/10`;move++},300);timers.push(cluster)}},260);timers.push(tick);scene.querySelector('#custom-status').textContent='As duas lanchonetes começaram com o mesmo pedido.'};
scene.querySelector('#custom-order-run').addEventListener('click',run);scene.querySelectorAll('.food-choice').forEach(x=>x.addEventListener('change',()=>{updateMenu();resetPreview()}));scene.querySelectorAll('.coord-input').forEach(x=>x.addEventListener('change',resetPreview));scene.querySelector('#custom-method-a').value='bubble';scene.querySelector('#custom-method-b').value='quick';updateMenu();resetPreview();
})();
</script>
