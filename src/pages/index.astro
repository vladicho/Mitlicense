const completeDefaults={sorting:{how:'Reorganiza os valores aplicando comparacoes e trocas ate obter a ordem desejada.',use:'Listas, registros, resultados e dados que precisam ser apresentados em ordem.',avoid:'Evite quando a lista for muito grande e houver uma estrategia mais adequada.',space:'Depende do algoritmo; pode ser O(1) ou O(n).',curiosity:'Algoritmos de ordenacao aparecem em bibliotecas, bancos de dados e interfaces.'},search:{how:'Examina a estrutura de dados seguindo uma estrategia para localizar um alvo.',use:'Catalogos, indices, arquivos, produtos e registros.',avoid:'Evite quando a estrutura nao permitir as suposicoes do algoritmo.',space:'Normalmente O(1), podendo crescer com a estrutura auxiliar.',curiosity:'A escolha da busca depende tanto da organizacao dos dados quanto da velocidade desejada.'},graphs:{how:'Visita vertices e arestas para descobrir caminhos, conexoes ou propriedades da rede.',use:'Mapas, redes sociais, dependencias e sistemas de transporte.',avoid:'Evite quando o problema nao puder ser representado naturalmente como uma rede.',space:'Geralmente O(V + E), considerando vertices e arestas.',curiosity:'Grafos modelam desde estradas ate recomendacoes e dependencias de pacotes.'},structures:{how:'Organiza dados para tornar insercoes, consultas ou remocoes mais eficientes.',use:'Bancos de dados, caches, sistemas operacionais e aplicacoes.',avoid:'Evite quando a estrutura adicionar complexidade sem necessidade.',space:'Varia conforme a quantidade de elementos e os indices mantidos.',curiosity:'A estrutura escolhida muitas vezes importa tanto quanto o algoritmo que a utiliza.'},strings:{how:'Processa caracteres, padroes ou substrings para encontrar, comparar ou transformar texto.',use:'Editores, buscas, logs, compiladores e ferramentas de linguagem.',avoid:'Evite processar texto bruto sem considerar codificacao e tamanho da entrada.',space:'Varia de O(1) a O(n) ou O(nm), conforme a tabela auxiliar.',curiosity:'Motores de busca e compiladores dependem de algoritmos especializados para texto.'},dp:{how:'Divide o problema em subproblemas e guarda resultados para nao recalcula-los.',use:'Planejamento, custos, sequencias, escalas e otimizacao.',avoid:'Evite quando o estado ficar maior que a memoria disponivel.',space:'Geralmente proporcional ao numero de estados armazenados.',curiosity:'Programacao dinamica transforma repeticao em memoria e planejamento.'},geometry:{how:'Compara pontos, linhas, distancias ou formas usando relacoes geometricas.',use:'Mapas, CAD, jogos, visao computacional e simulacoes.',avoid:'Evite sem tratar arredondamentos e casos de borda numericos.',space:'Depende da quantidade de pontos e estruturas geometricas auxiliares.',curiosity:'Muitos efeitos visuais e recursos de mapas sao geometria computacional disfarçada.'},utilities:{how:'Aplica uma transformacao, verificacao, estimativa ou calculo especializado aos dados.',use:'Criptografia, compressao, redes, simulacao e processamento de arquivos.',avoid:'Evite quando o metodo nao oferecer as garantias necessarias para o problema.',space:'Varia conforme a saida e as tabelas auxiliares.',curiosity:'Algoritmos utilitarios costumam ficar invisiveis, mas sustentam recursos cotidianos.'},backtracking:{how:'Tenta uma escolha, continua o caminho e desfaz a escolha quando ela falha.',use:'Quebra-cabecas, combinacoes, escalas e problemas de restricoes.',avoid:'Evite entradas grandes sem poda ou outra tecnica de reducao.',space:'Geralmente proporcional a profundidade da busca.',curiosity:'Backtracking e a forma sistematica de explorar possibilidades sem perder o caminho.'}};
