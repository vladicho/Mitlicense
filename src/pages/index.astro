function render(s={}){$("visual").innerHTML="";if(["sorting","search"].includes(cur.category)){let b=document.createElement("div");b.className="bars";let m=Math.max(...vals,1);vals.forEach((v,i)=>{let e=document.createElement("div");e.className="bar";e.dataset.v=v;e.style.height=`${Math.max(10,v/m*100)}%`;if((s.active||[]).includes(i))e.classList.add("active");if((s.done||[]).includes(i))e.classList.add("done");b.appendChild(e)});$("visual").appendChild(b)}else{let n=document.createElement("div");n.className="nodes";vals.forEach((v,i)=>{let e=document.createElement("div");e.className="node";e.textContent=cur.category==="graphs"?String.fromCharCode(65+i):v;if((s.active||[]).includes(i))e.classList.add("active");if((s.done||[]).includes(i))e.classList.add("done");n.appendChild(e)});$("visual").appendChild(n)}}
