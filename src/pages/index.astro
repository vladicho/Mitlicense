const algorithms = [{"id": "alg-0", "category": "sorting", "name": "Bubble Sort", "complexity": "O(n²)", "description": "Visualização interativa de Bubble Sort."}, {"id": "alg-1", "category": "sorting", "name": "Selection Sort", "complexity": "O(n²)", "description": "Visualização interativa de Selection Sort."}, {"id": "alg-2", "category": "sorting", "name": "Insertion Sort", "complexity": "O(n²)", "description": "Visualização interativa de Insertion Sort."}, {"id": "alg-3", "category": "sorting", "name": "Merge Sort", "complexity": "O(n log n)", "description": "Visualização interativa de Merge Sort."}, {"id": "alg-4", "category": "sorting", "name": "Quick Sort", "complexity": "O(n log n)", "description": "Visualização interativa de Quick Sort."}, {"id": "alg-5", "category": "search", "name": "Busca Linear", "complexity": "O(n)", "description": "Visualização interativa de Busca Linear."}, {"id": "alg-6", "category": "search", "name": "Busca Binária", "complexity": "O(log n)", "description": "Visualização interativa de Busca Binária."}, {"id": "alg-7", "category": "search", "name": "Jump Search", "complexity": "O(√n)", "description": "Visualização interativa de Jump Search."}, {"id": "alg-8", "category": "search", "name": "Interpolation Search", "complexity": "O(log log n)", "description": "Visualização interativa de Interpolation Search."}, {"id": "alg-9", "category": "search", "name": "Exponential Search", "complexity": "O(log n)", "description": "Visualização interativa de Exponential Search."}, {"id": "alg-10", "category": "structures", "name": "Pilha", "complexity": "O(1)", "description": "Visualização interativa de Pilha."}, {"id": "alg-11", "category": "structures", "name": "Fila", "complexity": "O(1)", "description": "Visualização interativa de Fila."}, {"id": "alg-12", "category": "structures", "name": "Lista Ligada", "complexity": "O(n)", "description": "Visualização interativa de Lista Ligada."}, {"id": "alg-13", "category": "structures", "name": "Árvore Binária", "complexity": "O(log n)", "description": "Visualização interativa de Árvore Binária."}, {"id": "alg-14", "category": "structures", "name": "Heap", "complexity": "O(log n)", "description": "Visualização interativa de Heap."}, {"id": "alg-15", "category": "graphs", "name": "BFS", "complexity": "O(V+E)", "description": "Visualização interativa de BFS."}, {"id": "alg-16", "category": "graphs", "name": "DFS", "complexity": "O(V+E)", "description": "Visualização interativa de DFS."}, {"id": "alg-17", "category": "graphs", "name": "Dijkstra", "complexity": "O((V+E) log V)", "description": "Visualização interativa de Dijkstra."}, {"id": "alg-18", "category": "graphs", "name": "A*", "complexity": "Variável", "description": "Visualização interativa de A*."}, {"id": "alg-19", "category": "graphs", "name": "Kruskal", "complexity": "O(E log E)", "description": "Visualização interativa de Kruskal."}, {"id": "alg-20", "category": "recursion", "name": "Fatorial", "complexity": "O(n)", "description": "Visualização interativa de Fatorial."}, {"id": "alg-21", "category": "recursion", "name": "Fibonacci Recursivo", "complexity": "O(2ⁿ)", "description": "Visualização interativa de Fibonacci Recursivo."}, {"id": "alg-22", "category": "recursion", "name": "Torre de Hanói", "complexity": "O(2ⁿ)", "description": "Visualização interativa de Torre de Hanói."}, {"id": "alg-23", "category": "recursion", "name": "Percurso em Árvore", "complexity": "O(n)", "description": "Visualização interativa de Percurso em Árvore."}, {"id": "alg-24", "category": "recursion", "name": "Backtracking", "complexity": "Exponencial", "description": "Visualização interativa de Backtracking."}, {"id": "alg-25", "category": "dp", "name": "Mochila 0/1", "complexity": "O(nW)", "description": "Visualização interativa de Mochila 0/1."}, {"id": "alg-26", "category": "dp", "name": "Maior Subsequência Comum", "complexity": "O(nm)", "description": "Visualização interativa de Maior Subsequência Comum."}, {"id": "alg-27", "category": "dp", "name": "Troco de Moedas", "complexity": "O(n·valor)", "description": "Visualização interativa de Troco de Moedas."}, {"id": "alg-28", "category": "dp", "name": "Fibonacci DP", "complexity": "O(n)", "description": "Visualização interativa de Fibonacci DP."}, {"id": "alg-29", "category": "dp", "name": "Maior Subsequência Crescente", "complexity": "O(n²)", "description": "Visualização interativa de Maior Subsequência Crescente."}];
const categories = {"sorting": "Ordenação", "search": "Busca", "structures": "Estruturas de dados", "graphs": "Grafos", "recursion": "Recursão", "dp": "Programação dinâmica"};
---
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MITLicense — Visualizador</title>
<style is:global>
:root{--bg:#090b12;--panel:#141925;--panel2:#1b2231;--line:#2a354b;--text:#f7f9fc;--muted:#98a4b8;--accent:#7c5cff;--accent2:#2dd4bf;--ok:#34c77b;--warn:#f4b942}
*{box-sizing:border-box}body{margin:0;min-width:320px;background:radial-gradient(circle at 0 0,rgba(124,92,255,.18),transparent 34rem),radial-gradient(circle at 100% 0,rgba(45,212,191,.11),transparent 30rem),var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}
button,input{font:inherit}button{cursor:pointer}.wrap{width:min(1200px,calc(100% - 24px));margin:auto}
header{position:sticky;top:0;z-index:20;background:rgba(9,11,18,.84);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.top{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{font-weight:900;display:flex;align-items:center;gap:11px}
.logo{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2))}
.muted{color:var(--muted)}main{padding:42px 0 60px}h1{margin:0 0 12px;font-size:clamp(2.5rem,7vw,5.2rem);line-height:.95;letter-spacing:-.06em}
.gradient{background:linear-gradient(90deg,#c9beff,#76efe4);background-clip:text;color:transparent}.hero p{max-width:760px;color:var(--muted);line-height:1.65}
.layout{display:grid;grid-template-columns:300px minmax(0,1fr);gap:20px;align-items:start}.card{background:rgba(20,25,37,.9);border:1px solid var(--line);border-radius:20px}
aside{position:sticky;top:88px;padding:14px;max-height:calc(100vh - 108px);overflow:auto}.category h3{margin:10px 8px 7px;color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.1em}
.algo-btn{width:100%;text-align:left;border:1px solid transparent;background:transparent;color:var(--text);padding:10px 11px;border-radius:12px;margin:2px 0}
.algo-btn strong{display:block}.algo-btn small{color:var(--muted)}.algo-btn.active{background:rgba(124,92,255,.15);border-color:rgba(124,92,255,.55)}
.workspace{overflow:hidden}.head{padding:20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:15px}.head h2{margin:4px 0 6px;font-size:clamp(1.5rem,4vw,2.2rem)}.head p{margin:0;color:var(--muted)}
.badge{align-self:flex-start;border:1px solid rgba(45,212,191,.35);background:rgba(45,212,191,.1);color:#9af5eb;border-radius:999px;padding:8px 11px;font-size:.78rem;font-weight:800}
.controls{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:9px;align-items:center}.btn{min-height:42px;border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:11px;padding:0 14px;font-weight:750}.btn.primary{border:0;background:linear-gradient(135deg,var(--accent),#5a48e4)}
.controls label{margin-left:auto;color:var(--muted);display:flex;align-items:center;gap:8px;font-size:.82rem}.stage{padding:20px;min-height:430px;display:flex;flex-direction:column}
#visual{flex:1;min-height:320px;display:flex;align-items:center;justify-content:center}.bars{height:300px;width:100%;display:flex;align-items:flex-end;gap:clamp(3px,.8vw,10px);border-bottom:1px solid var(--line)}
.bar{flex:1 1 0;min-width:4px;border-radius:7px 7px 2px 2px;background:linear-gradient(180deg,var(--accent),#4f3fca);transition:.2s;position:relative}.bar.active{background:linear-gradient(180deg,var(--warn),#db8e18);transform:translateY(-6px)}.bar.done{background:linear-gradient(180deg,var(--ok),#1d9959)}.bar.faded{opacity:.22}
.bar::after{content:attr(data-value);position:absolute;bottom:calc(100% + 5px);left:50%;transform:translateX(-50%);font-size:.65rem;color:var(--muted)}
.nodes{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;width:100%}.node{min-width:62px;min-height:62px;display:grid;place-items:center;border:2px solid var(--line);border-radius:16px;background:var(--panel2);font-weight:900;transition:.2s}.node.active{border-color:var(--warn);transform:scale(1.08)}.node.done{border-color:var(--ok);background:rgba(52,199,123,.12)}
.matrix{display:grid;grid-template-columns:repeat(7,minmax(30px,52px));gap:5px}.cell{aspect-ratio:1;display:grid;place-items:center;border:1px solid var(--line);border-radius:8px;background:var(--panel2);font-size:.78rem}.cell.active{border-color:var(--warn);background:rgba(244,185,66,.13)}.cell.done{border-color:var(--ok);background:rgba(52,199,123,.12)}
.status{padding-top:16px;border-top:1px solid var(--line);color:var(--muted);min-height:54px}.codegrid{border-top:1px solid var(--line);padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
pre{margin:0;min-height:210px;white-space:pre-wrap;overflow:auto;background:#090d16;border:1px solid var(--line);border-radius:14px;padding:16px;color:#dce7ff;line-height:1.55}
ol{margin:0;padding:0;list-style:none;display:grid;gap:8px}ol li{padding:10px 12px;border:1px solid var(--line);border-radius:11px;color:var(--muted)}ol li.active{color:var(--text);border-color:rgba(124,92,255,.6);background:rgba(124,92,255,.1)}
footer{text-align:center;color:var(--muted);padding-top:28px;font-size:.82rem}
@media(max-width:900px){.layout{grid-template-columns:1fr}aside{position:static;max-height:none}.category-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.wrap{width:min(100% - 16px,1200px)}.category-list{grid-template-columns:1fr}.head{flex-direction:column}.controls label{width:100%;margin-left:0}.controls input{flex:1}.stage{padding:12px;min-height:390px}#visual{min-height:280px}.bars{height:250px;gap:3px}.codegrid{grid-template-columns:1fr}.matrix{width:100%;grid-template-columns:repeat(7,minmax(26px,1fr))}}

@media(max-width:600px){
  .bar::after{
    display:block;
    font-size:.56rem;
    bottom:calc(100% + 3px);
  }
  .bars{
    padding-top:18px;
  }
}

</style>
</head>
<body>
<header><div class="wrap top"><div class="brand"><div class="logo">⌁</div><div>MITLicense<div class="muted" style="font-size:.72rem">30 visualizações</div></div></div><div class="muted">6 categorias · 30 projetos</div></div></header>
<main class="wrap">
<section class="hero"><h1>Algoritmos em <span class="gradient">movimento.</span></h1><p>Explore ordenação, busca, estruturas de dados, grafos, recursão e programação dinâmica com animações e explicações passo a passo.</p></section>
<section class="layout">
<aside class="card">
{Object.entries(categories).map(([categoryId,categoryLabel]) => (
<section class="category"><h3>{categoryLabel}</h3><div class="category-list">
{algorithms.filter((a)=>a.category===categoryId).map((a)=><button class:list={["algo-btn",{active:a.id==="alg-0"}]} data-id={a.id} type="button"><strong>{a.name}</strong><small>{a.complexity}</small></button>)}
</div></section>))}
</aside>
<article class="card workspace">
<div class="head"><div><small id="category">ORDENAÇÃO</small><h2 id="title">Bubble Sort</h2><p id="description">Visualização interativa de Bubble Sort.</p></div><span id="complexity" class="badge">O(n²)</span></div>
<div class="controls"><button id="newInput" class="btn" type="button">Nova entrada</button><button id="step" class="btn" type="button">Passo</button><button id="play" class="btn primary" type="button">▶ Executar</button><button id="reset" class="btn" type="button">Reiniciar</button><label>Velocidade <input id="speed" type="range" min="80" max="900" value="500" step="20"></label></div>
<div class="stage"><div id="visual"></div><div id="status" class="status" aria-live="polite">Pronto para começar.</div></div>
<div class="codegrid"><pre id="code"></pre><ol id="steps"></ol></div>
</article></section><footer>MITLicense · Astro · Cloudflare Pages</footer></main>
<script is:inline>
const algorithms=[{"id": "alg-0", "category": "sorting", "name": "Bubble Sort", "complexity": "O(n²)", "description": "Visualização interativa de Bubble Sort."}, {"id": "alg-1", "category": "sorting", "name": "Selection Sort", "complexity": "O(n²)", "description": "Visualização interativa de Selection Sort."}, {"id": "alg-2", "category": "sorting", "name": "Insertion Sort", "complexity": "O(n²)", "description": "Visualização interativa de Insertion Sort."}, {"id": "alg-3", "category": "sorting", "name": "Merge Sort", "complexity": "O(n log n)", "description": "Visualização interativa de Merge Sort."}, {"id": "alg-4", "category": "sorting", "name": "Quick Sort", "complexity": "O(n log n)", "description": "Visualização interativa de Quick Sort."}, {"id": "alg-5", "category": "search", "name": "Busca Linear", "complexity": "O(n)", "description": "Visualização interativa de Busca Linear."}, {"id": "alg-6", "category": "search", "name": "Busca Binária", "complexity": "O(log n)", "description": "Visualização interativa de Busca Binária."}, {"id": "alg-7", "category": "search", "name": "Jump Search", "complexity": "O(√n)", "description": "Visualização interativa de Jump Search."}, {"id": "alg-8", "category": "search", "name": "Interpolation Search", "complexity": "O(log log n)", "description": "Visualização interativa de Interpolation Search."}, {"id": "alg-9", "category": "search", "name": "Exponential Search", "complexity": "O(log n)", "description": "Visualização interativa de Exponential Search."}, {"id": "alg-10", "category": "structures", "name": "Pilha", "complexity": "O(1)", "description": "Visualização interativa de Pilha."}, {"id": "alg-11", "category": "structures", "name": "Fila", "complexity": "O(1)", "description": "Visualização interativa de Fila."}, {"id": "alg-12", "category": "structures", "name": "Lista Ligada", "complexity": "O(n)", "description": "Visualização interativa de Lista Ligada."}, {"id": "alg-13", "category": "structures", "name": "Árvore Binária", "complexity": "O(log n)", "description": "Visualização interativa de Árvore Binária."}, {"id": "alg-14", "category": "structures", "name": "Heap", "complexity": "O(log n)", "description": "Visualização interativa de Heap."}, {"id": "alg-15", "category": "graphs", "name": "BFS", "complexity": "O(V+E)", "description": "Visualização interativa de BFS."}, {"id": "alg-16", "category": "graphs", "name": "DFS", "complexity": "O(V+E)", "description": "Visualização interativa de DFS."}, {"id": "alg-17", "category": "graphs", "name": "Dijkstra", "complexity": "O((V+E) log V)", "description": "Visualização interativa de Dijkstra."}, {"id": "alg-18", "category": "graphs", "name": "A*", "complexity": "Variável", "description": "Visualização interativa de A*."}, {"id": "alg-19", "category": "graphs", "name": "Kruskal", "complexity": "O(E log E)", "description": "Visualização interativa de Kruskal."}, {"id": "alg-20", "category": "recursion", "name": "Fatorial", "complexity": "O(n)", "description": "Visualização interativa de Fatorial."}, {"id": "alg-21", "category": "recursion", "name": "Fibonacci Recursivo", "complexity": "O(2ⁿ)", "description": "Visualização interativa de Fibonacci Recursivo."}, {"id": "alg-22", "category": "recursion", "name": "Torre de Hanói", "complexity": "O(2ⁿ)", "description": "Visualização interativa de Torre de Hanói."}, {"id": "alg-23", "category": "recursion", "name": "Percurso em Árvore", "complexity": "O(n)", "description": "Visualização interativa de Percurso em Árvore."}, {"id": "alg-24", "category": "recursion", "name": "Backtracking", "complexity": "Exponencial", "description": "Visualização interativa de Backtracking."}, {"id": "alg-25", "category": "dp", "name": "Mochila 0/1", "complexity": "O(nW)", "description": "Visualização interativa de Mochila 0/1."}, {"id": "alg-26", "category": "dp", "name": "Maior Subsequência Comum", "complexity": "O(nm)", "description": "Visualização interativa de Maior Subsequência Comum."}, {"id": "alg-27", "category": "dp", "name": "Troco de Moedas", "complexity": "O(n·valor)", "description": "Visualização interativa de Troco de Moedas."}, {"id": "alg-28", "category": "dp", "name": "Fibonacci DP", "complexity": "O(n)", "description": "Visualização interativa de Fibonacci DP."}, {"id": "alg-29", "category": "dp", "name": "Maior Subsequência Crescente", "complexity": "O(n²)", "description": "Visualização interativa de Maior Subsequência Crescente."}]; const categories={"sorting": "Ordenação", "search": "Busca", "structures": "Estruturas de dados", "graphs": "Grafos", "recursion": "Recursão", "dp": "Programação dinâmica"};
const $=id=>document.getElementById(id); const visual=$("visual"),status=$("status"),playButton=$("play"),speed=$("speed");
let current=algorithms[0],initial=[],values=[],actions=[],cursor=0,playing=false,timer=null;
const codeTemplates={sorting:`função ordenar(lista)
  repita comparações
  troque ou mova valores
  marque as posições concluídas`,search:`função buscar(lista, alvo)
  escolha a região atual
  compare com o alvo
  reduza o espaço de busca`,structures:`crie a estrutura
insira elementos
percorra ou remova
observe o estado final`,graphs:`marque a origem
visite os vizinhos
controle os nós pendentes
encerre ao visitar todos`,recursion:`função resolver(n)
  se caso base: retorne
  chame resolver(n - 1)
  combine o resultado`,dp:`crie a tabela
reutilize resultados anteriores
atualize cada estado
retorne a melhor resposta`};
const stepTemplates={sorting:["Gera os valores.","Compara posições.","Atualiza a ordem.","Marca a conclusão."],search:["Organiza a entrada.","Escolhe a região.","Compara com o alvo.","Encontra ou encerra."],structures:["Cria a estrutura.","Insere elementos.","Processa os itens.","Mostra o estado final."],graphs:["Cria o grafo.","Escolhe a origem.","Visita os vizinhos.","Conclui o percurso."],recursion:["Cria uma chamada.","Avança ao caso base.","Retorna pelos níveis.","Combina resultados."],dp:["Cria a tabela.","Lê estados anteriores.","Atualiza células.","Obtém a resposta."]};
function randomArray(count=14){return Array.from({length:count},()=>Math.floor(Math.random()*86)+10)}
function createInput(){if(current.category==="dp")return Array.from({length:35},()=>0);if(["structures","graphs","recursion"].includes(current.category))return Array.from({length:10},(_,i)=>i+1);return randomArray(innerWidth<600?10:14)}
function buildActions(){const out=[];if(current.category==="sorting"){const a=[...initial];for(let p=0;p<a.length-1;p++){const i=p%(a.length-1),j=i+1;out.push({active:[i,j],text:`Comparando ${a[i]} e ${a[j]}.`});if(a[i]>a[j]){[a[i],a[j]]=[a[j],a[i]];out.push({values:[...a],active:[i,j],text:"Trocando os valores."})}}a.sort((x,y)=>x-y);out.push({values:a,done:a.map((_,i)=>i),text:"Ordenação concluída."})}else if(current.category==="search"){const a=[...initial].sort((x,y)=>x-y),target=a[Math.floor(a.length*.65)];out.push({values:a,text:`Alvo escolhido: ${target}.`});for(let i=0;i<a.length;i++){out.push({active:[i],faded:a.map((_,x)=>x).filter(x=>x<i),text:`Verificando ${a[i]}.`});if(a[i]===target){out.push({active:[i],done:[i],text:`Encontrado: ${target}.`});break}}}else if(current.category==="dp"){for(let i=0;i<initial.length;i++)out.push({active:[i],done:Array.from({length:i},(_,x)=>x),text:`Calculando célula ${i+1}.`});out.push({done:initial.map((_,i)=>i),text:"Tabela concluída."})}else{for(let i=0;i<initial.length;i++)out.push({active:[i],done:Array.from({length:i},(_,x)=>x),text:`Processando elemento ${i+1}.`});out.push({done:initial.map((_,i)=>i),text:"Visualização concluída."})}return out}
function render(s={}){visual.innerHTML="";if(["sorting","search"].includes(current.category)){const box=document.createElement("div");box.className="bars";const max=Math.max(...values,1);values.forEach((v,i)=>{const b=document.createElement("div");b.className="bar";b.dataset.value=String(v);b.style.height=`${Math.max(10,(v/max)*100)}%`;if((s.active||[]).includes(i))b.classList.add("active");if((s.done||[]).includes(i))b.classList.add("done");if((s.faded||[]).includes(i))b.classList.add("faded");box.appendChild(b)});visual.appendChild(box);return}if(current.category==="dp"){const m=document.createElement("div");m.className="matrix";values.forEach((_,i)=>{const c=document.createElement("div");c.className="cell";c.textContent=String((i*3)%11);if((s.active||[]).includes(i))c.classList.add("active");if((s.done||[]).includes(i))c.classList.add("done");m.appendChild(c)});visual.appendChild(m);return}const n=document.createElement("div");n.className="nodes";values.forEach((v,i)=>{const el=document.createElement("div");el.className="node";el.textContent=current.category==="graphs"?String.fromCharCode(65+i):String(v);if((s.active||[]).includes(i))el.classList.add("active");if((s.done||[]).includes(i))el.classList.add("done");n.appendChild(el)});visual.appendChild(n)}
function apply(a){if(a.values)values=[...a.values];render(a);status.textContent=a.text;const list=[...document.querySelectorAll("#steps li")],phase=Math.min(3,Math.floor(cursor/Math.max(1,actions.length/4)));list.forEach((x,i)=>x.classList.toggle("active",i===phase))}
function next(){if(cursor>=actions.length){playing=false;playButton.textContent="▶ Executar";return false}apply(actions[cursor++]);return true}
function loop(){if(!playing)return;if(next())timer=setTimeout(loop,980-Number(speed.value))}
function prepare(){clearTimeout(timer);playing=false;playButton.textContent="▶ Executar";initial=createInput();values=[...initial];actions=buildActions();cursor=0;render();status.textContent="Pronto para começar."}
function selectAlgorithm(id){current=algorithms.find(a=>a.id===id);document.querySelectorAll(".algo-btn").forEach(b=>b.classList.toggle("active",b.dataset.id===id));$("category").textContent=categories[current.category].toUpperCase();$("title").textContent=current.name;$("description").textContent=current.description;$("complexity").textContent=current.complexity;$("code").textContent=codeTemplates[current.category];$("steps").innerHTML=stepTemplates[current.category].map(x=>`<li>${x}</li>`).join("");prepare()}
document.querySelectorAll(".algo-btn").forEach(b=>b.addEventListener("click",()=>selectAlgorithm(b.dataset.id)));$("newInput").addEventListener("click",prepare);$("reset").addEventListener("click",()=>{values=[...initial];actions=buildActions();cursor=0;render();status.textContent="Reiniciado."});$("step").addEventListener("click",()=>{playing=false;clearTimeout(timer);playButton.textContent="▶ Executar";next()});playButton.addEventListener("click",()=>{playing=!playing;playButton.textContent=playing?"❚❚ Pausar":"▶ Continuar";if(playing)loop();else clearTimeout(timer)});addEventListener("resize",()=>render());selectAlgorithm("alg-0");
</script></body></html>