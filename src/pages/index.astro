ca',merge:'Merge Sort + busca',bubble:'Bubble Sort + busca',tim:'Tim Sort + busca',heap:'Heap Sort + busca'};const fieldText={price:'valor',diet:'categoria de calorias',type:'tipo',prep:'preparo',service:'embalagem'};const q=box.querySelector('#snack-request'),field=box.querySelector('#snack-field'),aa=box.querySelector('#snack-a'),bb=box.querySelector('#snack-b'),svc=box.querySelector('#snack-service'),status=box.querySelector('#snack-status');let timers=[],run=0;const sorted=(f)=>data.map((_,i)=>i).sort((x,y)=>String(data[x][f]).localeCompare(String(data[y][f]),'pt-BR',{numeric:true}));const make=(method,target,f)=>({method,target,field:f,order:method==='binary'?sorted(f):data.map((_,i)=>i),phase:method==='binary'||method==='linear'?'search':'sort',cursor:0,lo:0,hi:9,active:-1,found:-1,steps:0,message:'Aguardando...'});const draw=(s,foods,step,motion)=>{foods.innerHTML=s.order.map((idx,pos)=>'<span class="snack-card '+(s.active===idx?'snack-check ':'')+(s.found===idx?'snack-found ':'')+'">'+(pos+1)+'. '+names[idx]+'<small>R$ '+data[idx].price+' · '+data[idx][s.field]+'</small></span>').join('');step.textContent=s.message;motion.textContent=s.active>=0?'Caminhando até a posição '+(s.order.indexOf(s.active)+1)+'...':'Organizando o balcão...'};const next=s=>{s.steps++;if(s.phase==='sort'){if(s.cursor>=10){s.phase='search';s.cursor=0;s.active=-1;return 'Balcão organizado por '+fieldText[s.field]+'; procurando pedido.'}let min=s.cursor;for(let j=s.cursor+1;j<10;j++)if(String(data[s.order[j]][s.field]).localeCompare(String(data[s.order[min]][s.field]),'pt-BR',{numeric:true})<0)min=j;[s.order[s.cursor],s.order[min]]=[s.order[min],s.order[s.cursor]];s.active=s.order[s.cursor];s.cursor++;return labels[s.method].split(' +')[0]+': comparando e organizando.'}if(s.method==='binary'){if(s.lo>s.hi)return 'Pedido não encontrado.';const mid=Math.floor((s.lo+s.hi)/2),idx=s.order[mid];s.active=idx;if(idx===s.target){s.found=idx;return 'Busca binária encontrou a comida.'}if(String(data[idx][s.field]).localeCompare(String(data[s.target][s.field]),'pt-BR',{numeric:true})<0)s.lo=mid+1;else s.hi=mid-1;return 'Busca binária: eliminando metade do balcão.'}if(s.cursor>=10)return 'Pedido não encontrado.';const idx=s.order[s.cursor++];s.active=idx;if(idx===s.target){s.found=idx;return 'Comida encontrada após conferir '+s.steps+' posição(ões).'}return labels[s.method]+': conferindo a comida '+s.steps+'.'};const lane=(s,foods,step,motion,who,id)=>{if(id!==run)return;if(s.found>=0){s.message=who+' pegou '+names[s.found]+' para '+svc.value+'.';draw(s,foods,step,motion);status.textContent=who+' está preparando '+names[s.found]+' para '+svc.value.toLowerCase()+'.';return}s.message=next(s);draw(s,foods,step,motion);timers.push(setTimeout(()=>lane(s,foods,step,motion,who,id),300))};const labelsOn=()=>{box.querySelector('#snack-label-a').textContent='· '+labels[aa.value];box.querySelector('#snack-label-b').textContent='· '+labels[bb.value]};const start=()=>{timers.forEach(clearTimeout);timers=[];run++;const id=run,target=Number(q.value),f=field.value;status.textContent='Pedido igual aberto nas duas lanchonetes: '+names[target]+' · '+svc.value+'.';labelsOn();lane(make(aa.value,target,f),box.querySelector('#snack-foods-a'),box.querySelector('#snack-step-a'),box.querySelector('#snack-motion-a'),'Atendente A',id);lane(make(bb.value,target,f),box.querySelector('#snack-foods-b'),box.querySelector('#snack-step-b'),box.querySelector('#snack-motion-b'),'Atendente B',id)};aa.addEventListener('change',labelsOn);bb.addEventListener('change',labelsOn);box.querySelector('#snack-run').addEventListener('click',start);labelsOn();start()})();
</script>
