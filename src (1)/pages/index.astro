function tarjan(){let order=[0,1,2,3,4,5,6,7];return order.map((v,i)=>({active:[v],done:order.slice(0,i),text:`Atualizando índice e low-link de ${String.fromCharCode(65+v)}.`}))}
function balancedTree(kind){let o=[];vals.forEach((v,i)=>{o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Inserindo ${v} em ${kind}.`});if(i>2&&i%3===0)o.push({active:[i-1,i],text:"Reorganizando nós para manter equilíbrio."})});return o}
function segmentTree(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Construindo intervalo até ${i+1}.`});o.push({active:[2,3,4],text:"Consultando soma de um intervalo."});return o}
function fenwick(){let o=[];for(let i=0;i<vals.length;i++)o.push({active:[i],done:Array.from({length:i},(_,k)=>k),text:`Atualizando índices responsáveis por ${i+1}.`});return o}
function boyerMoore(){let o=[];for(let i=vals.length-5;i>=0;i--)o.push({active:[i,i+1,i+2,i+3],text:`Comparando janela da direita para a esquerda: ${i+1}.`});o.push({done:[10,11,12,13],text:"Padrão encontrado."});return o}
function zAlgorithm(){let o=[];for(let i=1;i<vals.length;i++)o.push({active:[0,i],done:Array.from({length:Math.max(0,i-1)},(_,k)=>k+1),text:`Calculando Z[${i}].`});return o}
